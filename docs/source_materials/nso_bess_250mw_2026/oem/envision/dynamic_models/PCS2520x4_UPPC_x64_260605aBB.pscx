      <script>
        <segment name="Computations" id="1350178711" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Fortran" id="542953721" classid="CoreSegment"><![CDATA[IF (($InSigMin < $Param_PPCLock_LV_OnLvl .OR. $InSigMax > $Param_PPCLock_HV_OnLvl) .AND. $OutSig == 0) THEN
      $OutSig = 1
END IF
IF ($OutSig == 1) THEN
!      IF (ABS($InErr) < 0.1 .AND. ($InSigMin >= $Param_PPCLock_LV_OffLvl .AND. $InSigMax <= $Param_PPCLock_HV_OffLvl)) THEN
!		$OutSig = 0	
!      END IF
!	IF ($InPCmdErr > 0.1 .AND. ($InSigMin >= $Param_PPCLock_LV_OffLvl .AND. $InSigMax <= $Param_PPCLock_HV_OffLvl)) THEN
!      		$OutSig = 0
!	END IF
	IF ($InSigMin >= $Param_PPCLock_LV_OffLvl .AND. $InSigMax <= $Param_PPCLock_HV_OffLvl) THEN
      		$OutSig = 0
	END IF
END IF]]></segment>
        <segment name="Branch" id="1236146585" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
    </Definition>
