   #CASE YD2*Lead {$X1(3) $N1(2) $X2(2) $G2} {$X1(3) $N1(2) $X2(2) $N2(3)} {$X1(3) $N1(2) $X2(3) $N2(2)}
   #CASE YD2*Lead {$X1(2) $N1(1) $X2(3) $G2} {$X1(2) $N1(1) $X2(3) $N2(1)} {$X1(2) $N1(1) $X2(2) $N2(1)}
