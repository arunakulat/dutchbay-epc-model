      <script>
        <segment name="Fortran" id="2572970" classid="CoreSegment"><![CDATA[#STORAGE REAL:6
#STORAGE      INTEGER:1
#LOCAL REAL FREQ_OLD
#LOCAL REAL FREQ_NEW
#LOCAL INTEGER TASKCOUNT
#LOCAL REAL DELTA



MY_NSTORF = NSTORF
NSTORF = NSTORF + 6

MY_NSTORI = NSTORI
NSTORI = NSTORI+ 1
TASKCOUNT = STORI(MY_NSTORI)

FREQ_OLD = STORF(MY_NSTORF+4)
FREQ_NEW = STORF(MY_NSTORF+5)
DFREQ_OLD = STORF(MY_NSTORF+2)

if (TASKCOUNT == 0) then
FREQ_OLD = FREQ_NEW
FREQ_NEW = $freqin
end if

$dfreq = (FREQ_NEW- FREQ_OLD)*5


STORF(MY_NSTORF+4) = FREQ_OLD
STORF(MY_NSTORF+5) = FREQ_NEW

$freqold = FREQ_NEW
$freqnew = FREQ_OLD

TASKCOUNT = TASKCOUNT + 1
if (TASKCOUNT > (0.2/$timestep)) then
TASKCOUNT =0
end if
STORI(MY_NSTORI) = TASKCOUNT]]></segment>
        <segment name="Branch" id="390179253" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Computations" id="1139994120" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
