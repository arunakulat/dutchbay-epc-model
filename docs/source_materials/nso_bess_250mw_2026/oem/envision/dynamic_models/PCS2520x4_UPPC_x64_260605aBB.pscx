     + $Par_QFactor, $Par_WTUProtectFactor, $Par_QCmdRateUpLim, $Par_Q_POC_Limit_pos,
     + $Par_Q_POC_Limit_neg, $Par_QControlKP, $Par_QControlKI, $Par_FreqResMode,
     + $Par_Qbase, $Par_VDroopControlKP, $Par_VDroopControlKI, $Par_PPCEnb, $Par_Pbase,
     + $Par_PPCInitTime, $Par_PLimK, $Par_PCmdRateUpLim, $Par_PControlKP, $Par_PControlKI,
     + $Par_WTStandardU, $Par_PCCStandardU, $Par_VDroopslope, $Par_VDroopDeadpos,
     + $Par_VDroopDeadneg, $Par_VLoopControlKP, $Par_VLoopControlKI, $Param_PPCLock_LV_OnLvl,
     + $Param_PPCLock_LV_OffLvl, $Param_PPCLock_HV_OnLvl, $Param_PPCLock_HV_OffLvl,
     + $Par_PPCLockONDelayTime, $Par_PPCLockOFFDelayTime, $Par_FreqStandard, $Par_FreqGenMin,
     + $Par_XL, $Par_RL, $Par_FRPCmdRampRate, $Par_FSMFreqFactor, $Par_FreqRespDeadUp,
     + $Par_IREnb, $Par_IR_Tj, $Par_IRPosDB, $Par_IRNegDB, $Par_FreqRespDeadDn,
     + $Par_FreqResUpLimit, $Par_FreqResDnLimit, $Par_LSFMOFreqFactor, $Par_FreqRespDeadUp_LSFMO,
     + $Par_LSMFO_PdnLim, $Par_LSFMUFreqFactor, $Par_FreqRespDeadDn_LSFMU, $Par_LSMFU_PupLim,
     + $Par_FFREnb, $Par_FFRPosDB, $Par_FFRNegDB, $Par_FFRPCmdRampRate, $Par_DeloadModeSwitch,
     + $Par_DeloadFreqFactor, $Par_SampleFreq, $Par_DeloadFreqRespDeadDn, $Par_Deload_PupLim,
     + $Par_DeloadPCmdRampRate, $Par_SampleTime, $Par_LatchingFuncEnb, $Par_FilterTime,
     + $Par_DelayTime, $Par_IRUpLimit, $Par_IRDnLimit, $Par_IRPCmdRampRate, $Par_PThresLimEnb)
