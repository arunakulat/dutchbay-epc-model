      <svg viewBox="-200 -200 200 200" size="4">
        <port model="Transfer" name="RSYS" x="18" y="54" dim="1" mode="Output" type="Real" internal="false"><![CDATA[true]]></port>
        <port model="Transfer" name="XFAULT" x="-18" y="-54" dim="1" mode="Output" type="Real" internal="false"><![CDATA[true]]></port>
        <port model="Transfer" name="RFAULT" x="18" y="-54" dim="1" mode="Output" type="Real" internal="false"><![CDATA[true]]></port>
        <port model="Transfer" name="XSYS" x="-18" y="54" dim="1" mode="Output" type="Real" internal="false"><![CDATA[true]]></port>
        <cond><![CDATA[true]]></cond>
        <rect x="-36" y="-36" width="72" height="72" stroke="black" stroke-width="0.2" stroke-dasharray="none" fill-style="Hollow" fill-fg="black" fill-bg="black" />
        <line x1="-18" y1="-54" x2="-18" y2="-37" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <line x1="18" y1="-54" x2="18" y2="-37" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <line x1="-18" y1="54" x2="-18" y2="36" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <line x1="18" y1="54" x2="18" y2="36" stroke="Black" stroke-width="0.2" stroke-dasharray="none" port="" />
        <text x="3" y="1" stroke="Black" font-size="Small" text-anchor="Middle"><![CDATA[SCRSet]]></text>
      </svg>
      <script>
        <segment name="Fortran" id="442583672" classid="CoreSegment"><![CDATA[!X,R VALUE CONTORL
#LOCAL REAL ZSYS
#LOCAL REAL UDIP
#LOCAL REAL ZFAULT  
if ($DipSelect == 0) then
UDIP     = 0.01
end if
if ($DipSelect == 1) then
UDIP     = 0.2
end if
if ($DipSelect == 2) then
UDIP     = 0.4
end if
if ($DipSelect == 3) then
UDIP     = 0.6
end if
if ($DipSelect == 4) then
UDIP     = 0.8
end if

UDIP     = $DipSelect
ZSYS  = ($VSOURCE*$VSOURCE)/($SCR*$PWINFARM*$NTURBINE)
$RSYS = ZSYS/SQRT(1+$X_RSYS*$X_RSYS)
$XSYS = ($RSYS * $X_RSYS)/(2 * 3.141592 * $Freq)

ZFAULT  = ZSYS*UDIP/(1-UDIP)
$RFAULT = ZFAULT  /SQRT(1+$X_RFAULT*$X_RFAULT)
$XFAULT = $RFAULT *($X_RFAULT)/(2*3.141592*$Freq)]]></segment>
        <segment name="Branch" id="1491636657" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Computations" id="1524783739" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
