        <segment name="Dsdyn" id="1634832257" classid="CoreSegment"><![CDATA[#STORAGE RTCI:3 STXFRF:61 
#BEGIN
!
      CALL COMPONENT_ID(ICALL_NO, $#Component)
      CALL Blackbox_PQVCmdInputDyn_Begin()
!
#ENDBEGIN
!
      CALL COMPONENT_ID(ICALL_NO, $#Component)
      CALL Blackbox_PQVCmdInputDyn($PQUCmd, $PBase, $UBase, $UnitScale,
     + $PCmdCtrlMode, $PCmdSet1, $PCmdSet2, $PCmdSet3, $PCmdSet4, $PCmdSet5, $PCmdSet6,
     + $PCmdStep2, $PCmdStep3, $PCmdStep4, $PCmdStep5, $PCmdStep6, $PCmdStep7,
     + $QCmdCtrlMode, $QCmdSet1, $QCmdSet2, $QCmdSet3, $QCmdSet4, $QCmdSet5, $QCmdSet6,
     + $QCmdStep2, $QCmdStep3, $QCmdStep4, $QCmdStep5, $QCmdStep6, $QCmdStep7,
     + $UCmdCtrlMode, $UCmdSet1, $UCmdSet2, $UCmdSet3, $UCmdSet4, $UCmdSet5, $UCmdSet6,
     + $UCmdStep2, $UCmdStep3, $UCmdStep4, $UCmdStep5, $UCmdStep6, $UCmdStep7)
!
]]></segment>
        <segment name="Dsout" id="1902635322" classid="CoreSegment"><![CDATA[#BEGIN
!
