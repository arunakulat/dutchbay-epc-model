        <segment name="Dsdyn" id="1303110854" classid="CoreSegment"><![CDATA[#STORAGE LOGICAL:29 INTEGER:177 REAL:8765 STOR:185 RTCL:86 RTCI:241 RTCF:176 STXFRI:65 STXFRF:843 
#BEGIN
!
      CALL COMPONENT_ID(ICALL_NO, $#Component)
      CALL Blackbox_UniversPPCDyn_Begin($Par_Qpriority, $Par_QContorlMode,
     + $Par_QFactor, $Par_WTUProtectFactor, $Par_Q_POC_Limit_pos, $Par_Q_POC_Limit_neg,
     + $Par_QControlKP, $Par_QControlKI, $Par_FreqResMode, $Par_Qbase, $Par_VDroopControlKP,
     + $Par_VDroopControlKI, $Par_PPCEnb, $Par_Pbase, $Par_PPCInitTime, $Par_PCmdRateUpLim,
     + $Par_PControlKP, $Par_PControlKI, $Par_WTStandardU, $Par_PCCStandardU,
     + $Par_VDroopslope, $Par_VDroopDeadpos, $Par_VDroopDeadneg, $Par_VLoopControlKP,
     + $Par_VLoopControlKI, $Par_PPCLockONDelayTime, $Par_PPCLockOFFDelayTime,
     + $Par_FreqStandard, $Par_FreqGenMin, $Par_XL, $Par_RL, $Par_FRPCmdRampRate,
     + $Par_FSMFreqFactor, $Par_FreqRespDeadUp, $Par_IREnb, $Par_IR_Tj, $Par_IRPosDB,
     + $Par_IRNegDB, $Par_FreqRespDeadDn, $Par_FreqResUpLimit, $Par_FreqResDnLimit,
     + $Par_LSFMOFreqFactor, $Par_FreqRespDeadUp_LSFMO, $Par_LSMFO_PdnLim, $Par_LSFMUFreqFactor,
     + $Par_FreqRespDeadDn_LSFMU, $Par_LSMFU_PupLim, $Par_FFREnb, $Par_FFRPosDB,
     + $Par_FFRNegDB, $Par_FFRPCmdRampRate, $Par_DeloadModeSwitch, $Par_DeloadFreqFactor,
     + $Par_SampleFreq, $Par_DeloadFreqRespDeadDn, $Par_Deload_PupLim, $Par_DeloadPCmdRampRate,
     + $Par_SampleTime, $Par_LatchingFuncEnb, $Par_FilterTime, $Par_DelayTime,
     + $Par_IRUpLimit, $Par_IRDnLimit, $Par_IRPCmdRampRate, $Par_PThresLimEnb)
!
#ENDBEGIN
!
      CALL COMPONENT_ID(ICALL_NO, $#Component)
      CALL Blackbox_UniversPPCDyn($WTGCmd4, $WTGCmd3, $WTGCmd2, $WTGCmd1,
     + $WTGFbk_4, $WTGFbk_3, $WTGFbk_2, $WTGFbk_1, $PQU_Cmd, $PCC_FreqRate, $PCC_Freq,
     + $PCC_Uini, $PCC_Qini, $PCC_P, $StatcomFbk_2, $StatcomFbk_1, $StatcomQCmd2,
