      <script>
        <segment name="Computations" id="1206689320" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Fortran" id="1684658920" classid="CoreSegment"><![CDATA[IF ($FFREnb) THEN
      $FFRSet= 1
END IF
IF ($FFRSet== 1) THEN
      IF (ABS($Perr) < 0.05 .AND. ($FFREnb==0)) THEN
		$FFRSet= 0	
      END IF
	IF (ABS($PCmderr)> 0.05 .AND. ($FFREnb==0)) THEN
      		$FFRSet= 0
	END IF
END IF]]></segment>
        <segment name="Branch" id="1538998491" classid="CoreSegment"><![CDATA[]]></segment>
      </script>
    </Definition>
