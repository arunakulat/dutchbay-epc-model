      <form name="" w="723" h="763" splitter="60" commentlines="4" help-width="490">
        <category name="Configuration" visible="true" splitter="60">
          <parameter name="Par_Qpriority" desc="Q Distribute Priority" type="Choice" group="QControlParam" helpmode="Append" animate="false">
            <value><![CDATA[2]]></value>
            <cond><![CDATA[]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[]]></help>
            <choice><![CDATA[1 = WT/BESS first]]></choice>
            <choice><![CDATA[2 = SVG first]]></choice>
            <choice><![CDATA[3 = Proportional (by installed Q capacity)]]></choice>
          </parameter>
          <parameter name="Par_QContorlMode" desc="Reactive Power Contorl Mode" type="Choice" group="QControlParam" helpmode="Append" animate="false">
            <value><![CDATA[1]]></value>
            <cond><![CDATA[]]></cond>
            <vis><![CDATA[]]></vis>
            <help><![CDATA[]]></help>
            <choice><![CDATA[1 = Q Control]]></choice>
            <choice><![CDATA[2 = Q/P ratio Control]]></choice>
            <choice><![CDATA[3 = PowerFactor Control]]></choice>
            <choice><![CDATA[4 = V Droop Control]]></choice>
            <choice><![CDATA[5 = V Loop Control]]></choice>
          </parameter>
          <parameter desc="WT/BESS Qcapacity Factor" name="Par_QFactor" group="QControlParam" unit="" min="0" max="1" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0.328]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter desc="WT/BESS Terminal V Protect Factor [pu]" name="Par_WTUProtectFactor" group="QControlParam" unit="" min="0" max="1E+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0.08]]></value>
            <cond />
            <help><![CDATA[Par_WTUProtectFactor]]></help>
            <vis />
          </parameter>
          <parameter desc="QCmd RampRate Limitation [pu/s]" name="Par_QCmdRateUpLim" group="QControlParam" unit="" min="0" max="1E+308" content_type="Variable" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[10]]></value>
            <cond />
            <help />
            <vis />
          </parameter>
          <parameter name="Par_Q_POC_Limit_pos" desc="PCC Max Positive Q Value [kVar]" type="Real" group="QControlParam" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="" min="0" max="1E+308">
            <value><![CDATA[1082]]></value>
            <cond><![CDATA[((Par_QContorlMode==1)||(Par_QContorlMode==2)||(Par_QContorlMode==3)||(Par_QContorlMode==4))]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter name="Par_Q_POC_Limit_neg" desc="PCC Max Negative Q Value [kVar]" type="Real" group="QControlParam" helpmode="Append" content_type="Literal" intent="Input" dim="1" animate="false" unit="" min="-1E+308" max="0">
            <value><![CDATA[-1082]]></value>
            <cond><![CDATA[((Par_QContorlMode==1)||(Par_QContorlMode==2)||(Par_QContorlMode==3)||(Par_QContorlMode==4))]]></cond>
            <vis><![CDATA[true]]></vis>
            <help><![CDATA[]]></help>
          </parameter>
          <parameter desc="Q Control Kp" name="Par_QControlKP" group="QControlParam" unit="" min="0" max="1E+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[0.2]]></value>
            <cond><![CDATA[((Par_QContorlMode==1)||(Par_QContorlMode==2)||(Par_QContorlMode==3))]]></cond>
            <help />
            <vis><![CDATA[true]]></vis>
          </parameter>
          <parameter desc="Q Control Ki" name="Par_QControlKI" group="QControlParam" unit="" min="0" max="1E+308" content_type="Literal" type="Real" helpmode="Append" intent="Input" dim="1" animate="false">
            <value><![CDATA[2]]></value>
