      <form name="" splitter="60">
        <category name="Configuration" visible="true">
          <cond><![CDATA[true]]></cond>
          <parameter name="Name" desc="Name" group="" type="Text" helpmode="Overwrite" allowemptystr="true" min="0" max="0">
            <value><![CDATA[]]></value>
            <cond><![CDATA[true]]></cond>
            <help><![CDATA[The name of the component]]></help>
            <regex><![CDATA[]]></regex>
            <error_msg><![CDATA[]]></error_msg>
            <vis />
          </parameter>
        </category>
      </form>
      <script>
        <segment name="Computations" id="938877488" classid="CoreSegment"><![CDATA[]]></segment>
        <segment name="Fortran" id="246464297" classid="CoreSegment"><![CDATA[#STORAGE REAL:6
#LOCAL REAL Qtotal
#LOCAL REAL deltaQ
#LOCAL REAL acmd
#LOCAL REAL bcmd


MY_NSTORF = NSTORF
NSTORF = NSTORF + 18

	Qtotal = STORF(MY_NSTORF)
	acmd = STORF(MY_NSTORF+6)
	bcmd = STORF(MY_NSTORF+12)
	deltaQ = $QCMD - Qtotal
	IF(deltaQ >= 0)THEN
		IF(acmd + deltaQ <= $A_CAP)THEN
			acmd = acmd + deltaQ
			bcmd = bcmd + 0
		ELSE
			bcmd = bcmd + deltaQ - ($A_CAP - acmd)
			acmd = $A_CAP
		ENDIF
	ELSE
		IF(acmd + deltaQ >= -$A_CAP)THEN
			acmd = acmd + deltaQ
			bcmd = bcmd + 0
		ELSE
			bcmd = bcmd + deltaQ - (-$A_CAP - acmd)
			acmd = -$A_CAP
		ENDIF	
	ENDIF	

	$A_QCMD = acmd
	$B_QCMD = bcmd
	Qtotal = acmd + bcmd
	STORF(MY_NSTORF) = Qtotal
	STORF(MY_NSTORF+6) = acmd
	STORF(MY_NSTORF+12) = bcmd]]></segment>
        <segment name="Branch" id="1566622745" classid="CoreSegment"><![CDATA[]]></segment>
