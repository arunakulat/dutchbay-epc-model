        RTCI(NRTCI + 14) = $NBBS(11)
        RTCI(NRTCI + 15) = $NBBS(12)
        RTCI(NRTCI + 16) = $NBBS(13)
        RTCI(NRTCI + 17) = $NBBS(14)
        RTCI(NRTCI + 18) = $NBBS(15)
        RTCI(NRTCI + 19) = $NBBS(16)
        RTCI(NRTCI + 20) = $NBBS(17)
        RTCI(NRTCI + 21) = $NBBS(18)
        RTCI(NRTCI + 22) = $NBBS(19)
        RTCI(NRTCI + 23) = $NBBS(20)
        RTCI(NRTCI + 24) = $NBBS(21)
!
        ND_IDX = NRTCI
        NRTCI = NRTCI + 25
!
      ELSE
!
        BR_IDX = NRTCI
        NRTCI = NRTCI + 37
!
        ND_IDX = NRTCI
        NRTCI = NRTCI + 25
!
      ENDIF
!
      CALL COMPONENT_ID(ICALL_NO, $#Component)
      CALL Blackbox_VoltageSourseSetOut(BR_IDX, ND_IDX, $SS)
!
]]></segment>
