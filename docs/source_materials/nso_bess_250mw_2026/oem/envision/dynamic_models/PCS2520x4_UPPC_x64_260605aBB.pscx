   #CASE YD2*Lead {$N1(3) $N1(2) $N2(2) $G2} {$N1(3) $N1(2) $N2(2) $N2(3)} {$N1(3) $N1(2) $N2(3) $N2(2)}
   #CASE YD2*Lead {$N1(2) $N1(1) $N2(3) $G2} {$N1(2) $N1(1) $N2(3) $N2(1)} {$N1(2) $N1(1) $N2(2) $N2(1)}
