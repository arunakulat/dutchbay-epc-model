        <segment name="Dsdyn" id="1248745904" classid="CoreSegment"><![CDATA[#STORAGE LOGICAL:29 INTEGER:177 REAL:8765 STOR:185 RTCL:86 RTCI:241 RTCF:176 STXFRI:65 STXFRF:843 
#BEGIN
!
