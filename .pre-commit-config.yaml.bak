# Pre-commit hooks configuration (Go-With-The-Flow CI)

repos:
  - repo: https://github.com/psf/black
    rev: "25.11.0"
    hooks:
      - id: black
        language_version: python3.11
        args: ["--line-length=88"]
        exclude: ^legacy/

  - repo: https://github.com/pycqa/isort
    rev: "7.0.0"
    hooks:
      - id: isort
        args: ["--profile=black"]
        exclude: ^legacy/

  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: "v0.14.6"
    hooks:
      - id: ruff
        args: ["--fix", "--exit-non-zero-on-fix"]
        exclude: |
          (?x)^(
            legacy/.*|
            scripts/.*|
            analytics/fx/.*|
            analytics/sensitivity/dashboard_demo\.py|
            analytics/sensitivity_visualization\.py|
            tests/contracts/test_sensitivity_edgecases\.py|
            constants\.py|
            fix_parameter_range_config\.py|
            go_with_the_flow_ci_enhanced\.py|
            go_with_the_flow_ci_v2_final\.py|
            quarantine_v14chat\.py|
            scan_v14chat_imports\.py|
            run_full_pipeline\.py|
            refactor_kpi_args\.py
          )$

  - repo: https://github.com/PyCQA/flake8
    rev: "7.3.0"
    hooks:
      - id: flake8
        args: ["--max-line-length=88", "--extend-ignore=W503"]
        exclude: |
          (?x)^(
            legacy/.*|
            scripts/.*|
            analytics/fx/.*|
            analytics/sensitivity/dashboard_demo\.py|
            analytics/sensitivity_visualization\.py|
            tests/contracts/test_sensitivity_edgecases\.py|
            constants\.py|
            fix_parameter_range_config\.py|
            go_with_the_flow_ci_enhanced\.py|
            go_with_the_flow_ci_v2_final\.py|
            quarantine_v14chat\.py|
            scan_v14chat_imports\.py|
            run_full_pipeline\.py
          )$

  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: "v6.0.0"
    hooks:
      - id: check-yaml
        exclude: |
          (?x)^(
            legacy/.*|
            scenarios/edge_extreme_stress\.yaml|
            scenarios/_scrtch/zz_bad\.yaml|
            config/sensitivity_defaults\.yaml|
            full_model_variables_updated\.yaml|
            \.github/workflows/release\.yml
          )$
      - id: check-json
        exclude: ^legacy/
      - id: check-toml
        exclude: ^legacy/
      - id: end-of-file-fixer
        exclude: ^legacy/
      - id: trailing-whitespace
        exclude: ^legacy/
      - id: check-merge-conflict
      - id: debug-statements
        exclude: ^legacy/

  # Mypy disabled for Sprint Day 6 - re-enable in Phase 2
  # - repo: https://github.com/pre-commit/mirrors-mypy
  #   rev: "v1.18.2"
  #   hooks:
  #     - id: mypy
  #       ...
