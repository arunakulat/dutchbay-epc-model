def xnpv(rate: float, cashflows: Sequence[float], dates: Sequence[datetime]=
) -&gt; float:
    """
    Date-adjusted Net Present Value (XNPV).
   =20
    NPV =3D sum CF[i] / (1+r)^((date[i]-date[0]).days/365.25)
   =20
    Parameters
    ----------
    rate : float
        Annual discount rate (decimal)
    cashflows : Sequence[float]
        Cashflow amounts
    dates : Sequence[datetime]
        Corresponding dates (must align with cashflows)
   =20
    Returns
    -------
    float
        Net Present Value adjusted for actual dates
   =20
    Notes
    -----
    - Uses 365.25 days per year convention
    - First date (dates[0]) is t=3D0 reference
    - Standard in Excel XNPV and project finance models
   =20
    Examples
    --------
    &gt;&gt;&gt; from datetime import datetime
    &gt;&gt;&gt; xnpv(0.10, [-1000, 500, 500],=20
    ...      [datetime(2020,1,1), datetime(2020,7,1), datetime(2021,1,1)])
    -44.87...
    """
    if len(cashflows) !=3D len(dates):
        raise ValueError("Cashflows and dates must have same length")
   =20
    t0 =3D dates[0]
    total =3D 0.0
   =20
    for cf, date in zip(cashflows, dates):
        days =3D (date - t0).days
        years =3D days / 365.25
        total +=3D cf / ((1.0 + rate) ** years)
   =20
    return total


def xirr(cashflows: Sequence[float], dates: Sequence[datetime]) -&gt; Optio=
nal[float]:
    """
    Date-adjusted Internal Rate of Return (XIRR).
   =20
    Finds rate r such that XNPV(r, cashflows, dates) =3D 0.
    Equivalent to Excel's XIRR function.
   =20
    Parameters
    ----------
    cashflows : Sequence[float]
        Cashflow amounts
    dates : Sequence[datetime]
        Corresponding dates (must align with cashflows)
   =20
    Returns
    -------
    Optional[float]
        Annual IRR as decimal, or None if not found
   =20
    Notes
    -----
    - Uses bisection solver (same as Excel XIRR)
    - Search range: -99.99% to 200% annual
    - Convergence: |XNPV| &lt; 1e-8
    - Max iterations: 100
   =20
    Edge Cases
    -----------
    - Mismatched lengths: raises ValueError
    - No sign change: returns None
    - All zero cashflows: returns None
   =20
    Examples
    --------
    &gt;&gt;&gt; from datetime import datetime
    &gt;&gt;&gt; xirr([-1000, 500, 700],=20
    ...      [datetime(2020,1,1), datetime(2021,1,1), datetime(2022,7,1)])
    0.2846...
    """
    if len(cashflows) !=3D len(dates):
        raise ValueError("Cashflows and dates must have same length")
   =20
    try:
        return _xirr_bisect(cashflows, dates)
    except Exception:
        return None


def _xirr_bisect(cashflows: Sequence[float], dates: Sequence[datetime]) -&g=
t; Optional[float]:
    """
    Bisection solver for XIRR. Internal use only.
   =20
    Search domain: [-0.9999, 2.0] (-99.99% to 200%)
    Convergence: |XNPV| &lt; 1e-8
    Max iterations: 100
    """
    lo, hi =3D -0.9999, 2.0
   =20
    # Check for sign change
    npv_lo =3D xnpv(lo, cashflows, dates)
    npv_hi =3D xnpv(hi, cashflows, dates)
   =20
    if abs(npv_lo) &lt; 1e-8:
        return lo
    if abs(npv_hi) &lt; 1e-8:
        return hi
   =20
    # No root in domain
    if (npv_lo &gt; 0 and npv_hi &gt; 0) or (npv_lo &lt; 0 and npv_hi &lt; =
0):
        return None
   =20
    # Bisection
    for _ in range(100):
        mid =3D (lo + hi) / 2.0
        npv_mid =3D xnpv(mid, cashflows, dates)
       =20
        if abs(npv_mid) &lt; 1e-8:
            return mid
       =20
        if (npv_lo &lt; 0 and npv_mid &gt; 0) or (npv_lo &gt; 0 and npv_mid=
 &lt; 0):
            hi =3D mid
        else:
            lo, npv_lo =3D mid, npv_mid
   =20
    return (lo + hi) / 2.0
