    )

    args =3D parser.parse_args(list(argv))

    scenarios_dir =3D Path(args.scenarios_dir)
    output_path =3D Path(args.output) if not args.no_excel else None

    sa =3D ScenarioAnalytics(
        scenarios_dir=3Dscenarios_dir,
