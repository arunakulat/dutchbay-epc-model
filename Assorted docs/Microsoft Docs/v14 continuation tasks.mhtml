class ChartGenerator:
    """Lightweight helper for generating PNG charts from analytics outputs.

    This is intentionally decoupled from Excel so it can be used in CLI/CI
    contexts without touching workbooks.

    Expected usage (per tests):

        cg =3D ChartGenerator(output_dir=3Dtmp_path)
        dscr_path =3D cg.plot_dscr_comparison(...)
        debt_path =3D cg.plot_debt_waterfall(...)
        kpi_path =3D cg.plot_kpi_comparison(...)
        npv_path =3D cg.plot_npv_distribution(...)
    """

    def __init__(self, output_dir: PathLike) -&gt; None:
        self.output_dir =3D Path(output_dir)
        self.output_dir.mkdir(parents=3DTrue, exist_ok=3DTrue)

    def _get_plt(self):
        try:
            import matplotlib.pyplot as plt  # type: ignore[import]
        except Exception as exc:  # pragma: no cover
            logger.warning("ChartGenerator: matplotlib not available: %s", =
exc)
            return None
        return plt

    def _resolve_path(self, output_file: PathLike) -&gt; Path:
        """Resolve output_file relative to output_dir and ensure parent exi=
sts."""
        path =3D Path(output_file)
        if not path.is_absolute():
            path =3D self.output_dir / path
        path.parent.mkdir(parents=3DTrue, exist_ok=3DTrue)
        return path

    # ------------------------------------------------------------------
    # KPI comparison (bar chart)
    # ------------------------------------------------------------------
    def plot_kpi_comparison(
        self,
        kpi_data: Union[pd.DataFrame, Mapping[str, Iterable[float]]],
        kpi_name: str,
        output_file: PathLike,
    ) -&gt; Path:
        """
        Create a simple bar chart comparing a KPI across scenarios.

        kpi_data: DataFrame or dict-like, typically with either:
            - a column named 'scenario_name', plus a column <code>kpi_name<=
/code>, or
            - index as scenario labels and a numeric column <code>kpi_name<=
/code>.

        Returns the pathlib.Path to the written PNG.
        """
        import pandas as pd

        plt =3D self._get_plt()
        if plt is None:  # pragma: no cover
            # Still return the path we *would* have written, to keep tests =
simple.
            return self._resolve_path(output_file)

        path =3D self._resolve_path(output_file)

        # Normalise to DataFrame
        if isinstance(kpi_data, pd.DataFrame):
            df =3D kpi_data.copy()
        else:
            df =3D pd.DataFrame(kpi_data)

        # Choose the y-series
        if kpi_name in df.columns:
            y =3D df[kpi_name]
        else:
            numeric_cols =3D df.select_dtypes("number").columns
            if not numeric_cols:
                raise ValueError("No numeric columns available for KPI char=
t")
            y =3D df[numeric_cols[0]]
            kpi_name =3D str(numeric_cols[0])

        # X labels from scenario_name or index
        if "scenario_name" in df.columns:
            labels =3D df["scenario_name"].astype(str).tolist()
        else:
            labels =3D df.index.astype(str).tolist()

        fig, ax =3D plt.subplots()
        ax.bar(range(len(y)), y)
        ax.set_xticks(range(len(labels)))
        ax.set_xticklabels(labels, rotation=3D45, ha=3D"right")
        ax.set_ylabel(kpi_name)
        ax.set_title(f"{kpi_name} comparison")
        fig.tight_layout()
        fig.savefig(path, dpi=3D150)
        plt.close(fig)

        return path

    # ------------------------------------------------------------------
    # NPV distribution (histogram)
    # ------------------------------------------------------------------
    def plot_npv_distribution(
        self,
        npv_values: Iterable[float],
        output_file: PathLike,
        bins: int =3D 20,
    ) -&gt; Path:
        """
        Plot a simple histogram for NPV values.

        npv_values: iterable of float
        Returns the pathlib.Path to the written PNG.
        """
        plt =3D self._get_plt()
        if plt is None:  # pragma: no cover
            return self._resolve_path(output_file)

        path =3D self._resolve_path(output_file)

        fig, ax =3D plt.subplots()
        ax.hist(list(npv_values), bins=3Dbins)
        ax.set_xlabel("NPV")
        ax.set_ylabel("Frequency")
        ax.set_title("NPV distribution")
        fig.tight_layout()
        fig.savefig(path, dpi=3D150)
        plt.close(fig)

        return path

    # ------------------------------------------------------------------
    # DSCR comparison (multi-scenario line chart with threshold)
    # ------------------------------------------------------------------
    def plot_dscr_comparison(
        self,
        scenario_data: Mapping[str, Sequence[float]],
        output_file: PathLike,
        threshold: Optional[float] =3D None,
    ) -&gt; Path:
        """Plot DSCR series for each scenario on a single chart."""
        plt =3D self._get_plt()
        if plt is None:  # pragma: no cover
            return self._resolve_path(output_file)

        path =3D self._resolve_path(output_file)

        fig, ax =3D plt.subplots()

        for name, series in scenario_data.items():
            y =3D list(series)
            x =3D list(range(1, len(y) + 1))
            ax.plot(x, y, marker=3D"o", label=3Dstr(name))

        if threshold is not None:
            ax.axhline(threshold, linestyle=3D"--", linewidth=3D1)

        ax.set_xlabel("Period")
        ax.set_ylabel("DSCR")
        ax.set_title("DSCR comparison by scenario")
        ax.legend()
        fig.tight_layout()
        fig.savefig(path, dpi=3D150)
        plt.close(fig)

        return path

    # ------------------------------------------------------------------
    # Debt waterfall (very simple stacked-style chart)
    # ------------------------------------------------------------------
    def plot_debt_waterfall(
        self,
        scenario_data: Mapping[str, Sequence[float]],
        output_file: PathLike,
    ) -&gt; Path:
        """Plot a simple 'waterfall-like' bar chart of ending debt by scena=
rio.

        This is intentionally minimal: tests only assert that a PNG file is
        created, not that the waterfall matches any particular styling spec=
.
        """
        plt =3D self._get_plt()
        if plt is None:  # pragma: no cover
            return self._resolve_path(output_file)

        path =3D self._resolve_path(output_file)

        labels =3D []
        values =3D []
        for name, series in scenario_data.items():
            labels.append(str(name))
            # Use final period as representative remaining debt
            s =3D list(series)
            values.append(s[-1] if s else 0.0)

        fig, ax =3D plt.subplots()
        ax.bar(range(len(values)), values)
        ax.set_xticks(range(len(labels)))
        ax.set_xticklabels(labels, rotation=3D45, ha=3D"right")
        ax.set_ylabel("Debt (end of horizon)")
        ax.set_title("Debt waterfall by scenario")
        fig.tight_layout()
        fig.savefig(path, dpi=3D150)
        plt.close(fig)

        return path
