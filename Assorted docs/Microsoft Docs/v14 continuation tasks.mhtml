es
    from Monte Carlo simulation results.
    """
   =20
    def __init__(self, confidence_level: float =3D 0.95):
        """
        Initialize risk analyzer.
       =20
        Parameters
        ----------
        confidence_level : float, default 0.95
            Confidence level for VaR/CVaR (e.g., 0.95 =3D 95% confidence)
        """
        self.confidence_level =3D confidence_level
        self.var_index =3D int((1 - confidence_level) * 100)  # Percentile =
index
   =20
    def calculate_var_cvar(
        self,=20
        returns: np.ndarray,=20
        return_type: str =3D 'equity_irr'
    ) -&gt; Dict[str, float]:
        """
        Calculate Value-at-Risk (VaR) and Conditional Value-at-Risk (CVaR).
       =20
        VaR(95%) =3D worst outcome at 95% confidence (5th percentile)
        CVaR(95%) =3D average of outcomes worse than VaR (expected shortfal=
l)
       =20
        Parameters
        ----------
        returns : np.ndarray
            Array of outcomes from Monte Carlo (e.g., IRR or NPV values)
        return_type : str
            Type of return for labeling ('equity_irr', 'project_npv', etc.)
       =20
        Returns
        -------
        dict
            {
