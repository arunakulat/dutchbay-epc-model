def _fx_curve(p: Dict[str, Any], years: int) -&gt; List[float]:
    """
    Build an FX curve (LKR per USD) for <code>years</code>.

    Supports:
      - Top-level scalar:   config["fx"] =3D 375.0  -&gt; flat curve
      - Mapping with curve: config["fx"]["curve"] or ["curve_lkr_per_usd"]
      - Mapping with start + annual_depr_pct
      - Legacy nested v14-style keys under "fx".
    """
    # Defensive guard
    years =3D max(1, int(years))

    fx_cfg =3D p.get("fx")

    # 1) Scenario loader has normalised fx to a scalar (e.g. 375.0)
    if isinstance(fx_cfg, (int, float)):
        rate =3D float(fx_cfg)
        return [rate] * years

    # 2) Mapping-style configuration under "fx"
    if isinstance(fx_cfg, dict):
        # 2a) Explicit curve list
        curve =3D fx_cfg.get("curve") or fx_cfg.get("curve_lkr_per_usd")
        if isinstance(curve, (list, tuple)):
            clean =3D [float(x) for x in curve]
            if len(clean) &gt;=3D years:
                return clean[:years]
            if clean:
                return clean + [clean[-1]] * (years - len(clean))

        # 2b) Parametric definition: start + annual depreciation
        start =3D fx_cfg.get("start_lkr_per_usd") or fx_cfg.get("start") or=
 fx_cfg.get("base") or fx_cfg.get("base_rate")
        if start is not None:
            start_val =3D float(start)
            depr_pct =3D fx_cfg.get("annual_depr_pct") or fx_cfg.get("depr_=
pct") or 0.0
            depr =3D _pct_to_decimal(depr_pct) or 0.0

            out: List[float] =3D []
            cur =3D start_val
            for _ in range(years):
                out.append(cur)
                cur *=3D (1.0 + depr)
            return out

    # 3) Legacy v14 nested keys fallback (if someone still uses that layout=
)
