                if key in rec:
                    dscr_scalar =3D rec[key]
                    break

            # One annual row per (scenario, period)
            for row in result.annual_rows:
                row_rec =3D dict(row)
                row_rec["scenario_name"] =3D result.name
                # If the annual rows don't already have a DSCR, attach the
                # scalar as a horizontal line =E2=80=93 better than having =
no series
                # at all for charting/export.
                if "dscr" not in row_rec and dscr_scalar is not None:
                    row_rec["dscr"] =3D dscr_scalar
                timeseries_records.append(row_rec)

        # -----------------------------------------------------------------=
-
        # Summary layer
        # -----------------------------------------------------------------=
-
        summary_df =3D pd.DataFrame(summary_records).set_index("scenario_na=
me")
        # Preserve scenario_name both as index (for existing callers) and a=
s
        # an explicit column (for filters / exporters that expect it).
        if "scenario_name" not in summary_df.columns:
            summary_df =3D summary_df.copy()
            summary_df.insert(0, "scenario_name", summary_df.index)

        # -----------------------------------------------------------------=
-
        # Timeseries layer + DSCR derivation
        # -----------------------------------------------------------------=
-
        timeseries_df =3D pd.DataFrame(timeseries_records)

        # If we already have a dscr column (e.g. from the scalar fallback
        # above or from the underlying finance layer), we don't attempt to
        # derive it again.
        if "dscr" not in timeseries_df.columns:
            cols =3D list(timeseries_df.columns)

            # CFADS candidates
            cfads_candidates =3D [c for c in cols if "cfads" in c.lower()]

            # Prefer final / LKR / post-tax CFADS if present
            cfads_col: Optional[str] =3D None
            preferred_order =3D ("cfads_final_lkr", "cfads_final", "posttax=
_cfads")
            for pref in preferred_order:
                for c in cfads_candidates:
                    if pref in c.lower():
