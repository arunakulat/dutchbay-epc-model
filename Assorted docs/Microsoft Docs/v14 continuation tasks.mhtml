<p data-start=3D"462" data-end=3D"553"><code data-start=3D"462" data-end=3D=
"484">finance.cashflow_v14</code>, <code data-start=3D"486" data-end=3D"504=
">finance.debt_v14</code>, <code data-start=3D"506" data-end=3D"519">financ=
e.irr</code> as the <em data-start=3D"527" data-end=3D"538">canonical</em> =
