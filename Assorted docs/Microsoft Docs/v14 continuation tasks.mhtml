<p data-start=3D"6509" data-end=3D"7081">def _compute_depreciation_schedule=
(<br>
capex_total: Optional[float],<br>
depreciation_years: int,<br>
enhanced_capital_allowance_pct: float,<br>
) -&gt; List[float]:<br>
"""<br>
Build a straight-line depreciation schedule over depreciation_years.<br>
enhanced_capital_allowance_pct allows &gt;100% total depreciation (e.g. 150=
% of capex).<br>
"""<br>
if capex_total is None or depreciation_years &lt;=3D 0:<br>
return []<br>
