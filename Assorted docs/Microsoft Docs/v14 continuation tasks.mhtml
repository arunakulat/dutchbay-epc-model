=3D"whitespace-pre-wrap">import os
import glob
import yaml
import json
import matplotlib.pyplot as plt
from dutchbay_v14chat.finance.cashflow import build_annual_rows_v14
from dutchbay_v14chat.finance.debt import apply_debt_layer

def load_config(path):
    if path.endswith('.json'):
        with open(path, 'r') as f:
            return json.load(f)
    elif path.endswith(('.yaml', '.yml')):
        with open(path, 'r') as f:
            return yaml.safe_load(f)
    else:
        raise ValueError("Unsupported file extension: " + path)

def get_scenario_files(directory):
    pats =3D ['*.json', '*.yaml', '*.yml']
    files =3D []
    for pat in pats:
        files.extend(glob.glob(os.path.join(directory, pat)))
    return files

def plot_batch(directory, metric=3D'dscr_series'):
    files =3D get_scenario_files(directory)
    if not files:
        print("No scenarios found!")
        return

    plt.figure(figsize=3D(10, 6))
    for file in files:
        label =3D os.path.splitext(os.path.basename(file))[0]
        try:
            config =3D load_config(file)
            annual_rows =3D build_annual_rows_v14(config)
            debt =3D apply_debt_layer(config, annual_rows)
            if metric =3D=3D 'dscr_series':
                ys =3D debt.get('dscr_series', [])
                xs =3D list(range(1, len(ys)+1))
                plt.plot(xs, ys, marker=3D'o', label=3Dlabel)
            elif metric =3D=3D 'debt_outstanding':
                ys =3D debt.get('debt_outstanding', [])
                xs =3D list(range(1, len(ys)+1))
                plt.plot(xs, ys, marker=3D'o', label=3Dlabel)
            elif metric =3D=3D 'cfads':
                ys =3D [row['cfads_usd'] for row in annual_rows]
                xs =3D [row['year'] for row in annual_rows]
                plt.plot(xs, ys, marker=3D'o', label=3Dlabel)
        except Exception as e:
            print(f"Error plotting {label}: {e}")

    plt.xlabel('Year')
    if metric =3D=3D 'dscr_series':
        plt.ylabel('DSCR')
        plt.title('Project DSCR per Scenario')
    elif metric =3D=3D 'debt_outstanding':
        plt.ylabel('Debt Outstanding (USD)')
        plt.title('Debt Outstanding per Scenario')
    elif metric =3D=3D 'cfads':
        plt.ylabel('CFADS (USD)')
        plt.title('CFADS per Scenario')
    plt.legend()
    plt.grid(True)
    plt.tight_layout()
    plt.show()

if __name__ =3D=3D "__main__":
    import argparse
    parser =3D argparse.ArgumentParser(description=3D"Plot DSCR, Debt, or C=
FADS across scenarios")
    parser.add_argument("--dir", "-d", type=3Dstr, required=3DTrue, help=3D=
"Scenario directory")
    parser.add_argument("--metric", "-m", type=3Dstr, choices=3D['dscr_seri=
es', 'debt_outstanding', 'cfads'], default=3D'dscr_series', help=3D"Metric =
to plot")
    args =3D parser.parse_args()
    plot_batch(args.dir, metric=3Dargs.metric)


