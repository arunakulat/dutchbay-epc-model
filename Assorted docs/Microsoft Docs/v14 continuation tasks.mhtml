def _as_float(x: Any, default: Optional[float] =3D None) -&gt; Optional[flo=
at]:
    """Safe float conversion with default fallback."""
    try:
        return float(x) if x is not None else default
    except Exception:
        return default


def _as_int(x: Any, default: int =3D 0) -&gt; int:
    """Safe integer conversion with default fallback."""
    try:
        return int(x)
    except Exception:
        return default


def _get(d: Dict[str, Any], path: List[str], default: Any =3D None) -&gt; A=
ny:
    """Safely traverse nested dictionary."""
    cur =3D d
    for k in path:
        if not isinstance(cur, dict) or k not in cur:
            return default
        cur =3D cur[k]
    return cur


