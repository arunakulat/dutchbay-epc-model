def apply_debt_layer(params: Dict[str, Any], annual_rows: List[Dict[str, An=
y]]) -&gt; Dict[str, Any]:
    """
    Apply debt financing layer with V14 construction period support.

    Parameters
    ----------
    params:
        Scenario configuration dictionary; must contain a Financing_Terms /=
 financing
        block and a capex.usd_total field.
    annual_rows:
        Per-period rows produced by v14 cashflow (build_annual_rows).

    Returns
    -------
    Dict[str, Any]
        Core engine outputs used by higher layers and tests.
    """
    # Extract financing params
    p =3D params.get("Financing_Terms", params.get("financing", params))

    # ---------- CONSTRUCTION PARAMETERS ----------
    construction_periods =3D int(_as_float(p.get("construction_periods"), 2=
))
    construction_schedule =3D p.get("construction_schedule", [40.0, 60.0])
    drawdown_pct =3D p.get("debt_drawdown_pct", [0.5, 0.5])
    grace_years =3D int(_as_float(p.get("grace_years"), 0))

    # ---------- STANDARD PARAMETERS ----------
    debt_ratio =3D _as_float(p.get("debt_ratio"), 0.70)
    tenor =3D int(_as_float(p.get("tenor_years"), 15))
    years_io =3D int(_as_float(p.get("interest_only_years"), 0))
    amortization =3D (p.get("amortization_style", "sculpted") or "sculpted"=
).lower()
    target_dscr =3D _as_float(p.get("target_dscr"), 1.30)

    capex =3D float(params.get("capex", {}).get("usd_total", 100.0))
    debt_total =3D capex * debt_ratio

    logger.info(
        "V14 Debt Planning: %d-year construction, %d-year tenor",
        construction_periods,
        tenor,
    )

    # ---------- TRANCHE MIX + IDC ----------
    tranches =3D _solve_mix(p, debt_total)

    idc_schedule: Dict[str, List[float]] =3D {}
    total_idc_by_tranche: Dict[str, float] =3D {}

    for tranche_name, tranche in tranches.items():
        drawn =3D calculate_construction_drawdowns(
            tranche.principal,
            construction_schedule,
            drawdown_pct,
        )

        idc_per_period, total_idc_cap =3D calculate_idc(
            drawn,
            tranche.rate,
            construction_periods,
        )

        idc_schedule[tranche_name] =3D idc_per_period
        total_idc_by_tranche[tranche_name] =3D total_idc_cap

        tranche.principal +=3D total_idc_cap
        logger.info(
            "  %s: Principal $%.2fM (IDC: $%.2fM)",
            tranche_name,
            tranche.principal,
            total_idc_cap,
        )

    principal_after_idc =3D {name: tr.principal for name, tr in tranches.it=
ems()}

    # ---------- EXTEND CFADS TO 23 PERIODS ----------
    cfads =3D [a.get("cfads_usd", 0.0) for a in annual_rows]

    cfads_extended: List[float] =3D []
    # Construction periods: 0 CFADS
    for _ in range(construction_periods):
        cfads_extended.append(0.0)

    # Transition period: partial CFADS (50%)
    if cfads:
        cfads_extended.append(cfads[0] * 0.5)
    else:
        cfads_extended.append(0.0)

    # Operational periods: full CFADS
    cfads_extended.extend(cfads)

    # Ensure exactly 23 periods
    while len(cfads_extended) &lt; 23:
        cfads_extended.append(cfads[-1] if cfads else 0.0)
    cfads_extended =3D cfads_extended[:23]

    # ---------- BUILD SCHEDULES ----------
    if amortization in ("annuity", "fixed"):
        schedules: Dict[str, List[Tuple[float, float, float]]] =3D {
            k: _annuity_schedule(tr, tenor - tr.years_io) for k, tr in tran=
ches.items()
        }
    else:
        schedules =3D _sculpted_schedule(
            tranches,
            tenor - years_io,
            cfads_extended[construction_periods:],
            target_dscr,
        )

    # Pad schedules with construction-period zeros
    for k in schedules:
        padded =3D [(0.0, 0.0, 0.0)] * construction_periods + schedules[k]
        schedules[k] =3D padded

    # ---------- COMPUTE METRICS OVER 23 PERIODS ----------
    dscr_series: List[float] =3D []
    debt_service_total: List[float] =3D []
    debt_outstanding: List[float] =3D []

    outstanding_balances =3D {k: tr.principal for k, tr in tranches.items()=
}

    for period in range(23):
        total_outstanding =3D sum(outstanding_balances.values())
        debt_outstanding.append(total_outstanding)

        total_service =3D 0.0
        for k in schedules:
            if period &lt; len(schedules[k]):
                interest, principal, service =3D schedules[k][period]
                total_service +=3D service
                outstanding_balances[k] =3D max(
                    0.0, outstanding_balances[k] - principal
                )

        debt_service_total.append(total_service)

        if period &lt; len(cfads_extended):
            cfads_this_period =3D cfads_extended[period]
        else:
            cfads_this_period =3D 0.0

        if period &gt;=3D construction_periods and total_service &gt; 0:
            dscr =3D cfads_this_period / total_service
        else:
            dscr =3D float("inf")

        dscr_series.append(dscr)

    dscr_operational =3D [
        d for i, d in enumerate(dscr_series) if i &gt;=3D construction_peri=
ods and d &lt; float("inf")
    ]
    dscr_min =3D min(dscr_operational) if dscr_operational else 0.0

    balloon_remaining =3D sum(outstanding_balances.values())
    total_idc_capitalized =3D sum(total_idc_by_tranche.values())

    logger.info(
        "V14 Results: Min DSCR=3D%.2f, Total IDC=3D$%.2fM",
        dscr_min,
        total_idc_capitalized,
    )

    audit_status =3D "PASS" if dscr_min &gt;=3D 1.30 else "REVIEW"

    return {
        # Time-series metrics
        "dscr_series": dscr_series,
        "dscr_min": dscr_min,
        "debt_service_total": debt_service_total,
        "debt_outstanding": debt_outstanding,
        "balloon_remaining": balloon_remaining,
        # V14 structural fields
        "construction_periods": construction_periods,
        "construction_schedule": construction_schedule,
        "idc_schedule": idc_schedule,
        "idc_by_tranche": total_idc_by_tranche,
        "principal_after_idc": principal_after_idc,
        "total_idc_capitalized": total_idc_capitalized,
        "grace_periods": grace_years,
        "timeline_periods": 23,
        "tenor_years": tenor,
        "cfads_extended": cfads_extended,
        "debt_schedules": schedules,
        # Validation / diagnostics
        "validation_warnings": [],
        "dscr_violations": [],
        "balloon_warnings": [],
        "audit_status": audit_status,
    }


# =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D
# PUBLIC V14 ENTRY POINT (USED BY TESTS)
# =3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=3D=
=3D=3D


def plan_debt(
    *,
    annual_rows: Sequence[Dict[str, Any]],
    config: Dict[str, Any],
) -&gt; Dict[str, Any]:
    """
    Stable v14 debt-planning API.

    This is a thin wrapper around `<code>apply_debt_layer</code><code> that=
:
</code>
      * feeds the raw scenario config into the engine,
      * derives construction / tenor years, and
      * exposes tranche-level principal + IDC totals in a pinned shape.

    It is what tests/api/test_debt_construction_idc_regression.py calls.
    """
    # 1) Run core engine
    core =3D apply_debt_layer(params=3Dconfig, annual_rows=3Dlist(annual_ro=
ws))

    # 2) High-level timeline
    construction_years =3D int(core.get("construction_periods", 0))
    tenor_years =3D int(core.get("tenor_years", 0))
    timeline_periods =3D int(core.get("timeline_periods", 0))

    if tenor_years &lt;=3D 0 and timeline_periods &gt; 0:
        tenor_years =3D max(timeline_periods - construction_years, 0)

    # 3) Tranche-level aggregates
    principal_by_tranche: Dict[str, float] =3D {
        k: float(v) for k, v in (core.get("principal_after_idc", {}) or {})=
.items()
    }
    idc_by_tranche: Dict[str, float] =3D {
        k: float(v) for k, v in (core.get("idc_by_tranche", {}) or {}).item=
s()
    }

    def _p(tranche: str) -&gt; float:
        return float(principal_by_tranche.get(tranche, 0.0))

    def _i(tranche: str) -&gt; float:
        return float(idc_by_tranche.get(tranche, 0.0))

    lkr_principal =3D _p("LKR")
    usd_principal =3D _p("USD")
    dfi_principal =3D _p("DFI")

    lkr_idc =3D _i("LKR")
    usd_idc =3D _i("USD")
    dfi_idc =3D _i("DFI")

    total_idc =3D lkr_idc + usd_idc + dfi_idc
    if "total_idc_capitalized" in core:
        total_idc =3D float(core.get("total_idc_capitalized", total_idc))

    min_dscr =3D float(core.get("dscr_min", 0.0))

    # 4) Shape the result to match the regression tests' expectations
    result: Dict[str, Any] =3D {
        # Pinned high-level fields
        "construction_years": construction_years,
        "tenor_years": tenor_years,
        "timeline_periods": timeline_periods,
        # Nested tranche summaries (what _extract_tranche(...) expects)
        "lkr": {
            "principal": lkr_principal,
            "principal_m": lkr_principal,
            "idc": lkr_idc,
            "idc_m": lkr_idc,
        },
        "usd": {
            "principal": usd_principal,
            "principal_m": usd_principal,
            "idc": usd_idc,
            "idc_m": usd_idc,
        },
        "dfi": {
            "principal": dfi_principal,
            "principal_m": dfi_principal,
            "idc": dfi_idc,
            "idc_m": dfi_idc,
        },
        "total_idc": total_idc,
        "min_dscr": min_dscr,
        # Compatibility / richer fields
        "construction_periods": core.get("construction_periods"),
        "grace_periods": core.get("grace_periods"),
        "construction_schedule": core.get("construction_schedule"),
        "principal_by_tranche": principal_by_tranche,
        "idc_by_tranche": idc_by_tranche,
        "cfads_extended": core.get("cfads_extended"),
        "debt_schedules": core.get("debt_schedules"),
        "debt_outstanding": core.get("debt_outstanding"),
        "debt_service_total": core.get("debt_service_total"),
        "balloon_remaining": core.get("balloon_remaining"),
        "audit_status": core.get("audit_status", "REVIEW"),
        # Extra flat fields for analytics / workbook layers
        "lkr_principal": lkr_principal,
        "usd_principal": usd_principal,
        "dfi_principal": dfi_principal,
        "lkr_idc": lkr_idc,
        "usd_idc": usd_idc,
        "dfi_idc": dfi_idc,
        "total_idc_capitalized": total_idc,
    }

    return result
