                ]
            if len(debt_candidates) !=3D 1:
                debt_candidates =3D [c for c in cols if "debt" in c.lower()=
]

            if cfads_col is not None and len(debt_candidates) =3D=3D 1:
                debt_col =3D debt_candidates[0]
                logger.info(
                    "Deriving per-period DSCR from %r / %r into 'dscr' colu=
mn",
