            if cfads_col is None and cfads_candidates:
                cfads_col =3D cfads_candidates[0]

            # Debt-service candidates =E2=80=93 progressively widen the net=
:
            #   1) '*debt_service*'
            #   2) 'debt' plus 'serv' or 'pay'
            #   3) any 'debt' column if still unique
            debt_candidates =3D [
