<p data-start=3D"25583" data-end=3D"26758">def build_annual_cfads(<br>
p: Dict[str, Any],<br>
fx_curve: Optional[List[float]] =3D None,<br>
capex_total: Optional[float] =3D None,<br>
interest_expense_series: Optional[List[float]] =3D None,<br>
verbose: bool =3D False,<br>
) -&gt; List[float]:<br>
params =3D _extract_parameters(p)<br>
years =3D params["project_life_years"]<br>
if fx_curve is None:<br>
fx_curve =3D _fx_curve(p, years)<br>
if capex_total is None:<br>
capex_usd =3D as_float(get_nested(p, ["capex", "usd_total"], None))<br>
if capex_usd is not None:<br>
capex_total =3D capex_usd * fx_curve[0]<br>
if interest_expense_series is None:<br>
interest_expense_series =3D [0.0] * years<br>
cfads_list =3D []<br>
for year in range(years):<br>
fx_rate =3D fx_curve[year] if year &lt; len(fx_curve) else fx_curve[-1]<br>
interest_lkr =3D interest_expense_series[year] if year &lt; len(interest_ex=
pense_series) else 0.0<br>
result =3D calculate_single_year_cfads(params, fx_rate, year, capex_total, =
interest_lkr, verbose=3Dverbose)<br>
cfads_list.append(result["cfads_final_lkr"])<br>
logger.info(f"Calculated CFADS for {years} years, range: {min(cfads_list):,=
.0f} to {max(cfads_list):,.0f}")<br>
return cfads_list</p>
<p data-start=3D"26761" data-end=3D"27946">def build_annual_rows(<br>
p: Dict[str, Any],<br>
fx_curve: Optional[List[float]] =3D None,<br>
capex_total: Optional[float] =3D None,<br>
interest_expense_series: Optional[List[float]] =3D None,<br>
) -&gt; List[Dict[str, float]]:<br>
params =3D _extract_parameters(p)<br>
years =3D params["project_life_years"]<br>
if fx_curve is None:<br>
fx_curve =3D _fx_curve(p, years)<br>
if capex_total is None:<br>
capex_usd =3D as_float(get_nested(p, ["capex", "usd_total"], None))<br>
if capex_usd is not None:<br>
capex_total =3D capex_usd * fx_curve[0]<br>
if interest_expense_series is None:<br>
interest_expense_series =3D [0.0] * years<br>
rows =3D []<br>
for year in range(years):<br>
fx_rate =3D fx_curve[year] if year &lt; len(fx_curve) else fx_curve[-1]<br>
interest_lkr =3D interest_expense_series[year] if year &lt; len(interest_ex=
pense_series) else 0.0<br>
result =3D calculate_single_year_cfads(params, fx_rate, year, capex_total, =
interest_lkr, verbose=3DFalse)<br>
result["revenue_usd"] =3D result["revenue_lkr"] / fx_rate if fx_rate &gt; 0=
 else 0.0<br>
result["cfads_usd"] =3D result["cfads_final_lkr"] / fx_rate if fx_rate &gt;=
 0 else 0.0<br>
rows.append(result)<br>
return rows</p>
