def _calculate_net_production(
    capacity_mw: float,
    capacity_factor: float,
    degradation: float,
    grid_loss_pct: float,
    year: int,
) -&gt; Tuple[float, float]:
    """
    Calculate gross and net kWh for a given year.

    - capacity_mw: installed capacity in MW
    - capacity_factor: baseline capacity factor (0=E2=80=931)
    - degradation: annual degradation rate (0=E2=80=931)
    - grid_loss_pct: grid losses between generation and offtake (0=E2=80=93=
1)
    - year: 0-based year index
    """
    hours_per_year =3D 8760
    effective_cf =3D capacity_factor * ((1 - degradation) ** year)
    gross_kwh =3D capacity_mw * 1e3 * hours_per_year * effective_cf
    grid_loss =3D gross_kwh * grid_loss_pct
    net_kwh =3D gross_kwh - grid_loss
    return gross_kwh, net_kwh


def _calculate_revenue_lkr(net_kwh: float, tariff_lkr_per_kwh: float) -&gt;=
 float:
    """Compute revenue in LKR =3D net energy * tariff."""
    return net_kwh * tariff_lkr_per_kwh


def _calculate_statutory_deductions(
    revenue_lkr: float,
    success_fee_pct: float,
    env_surcharge_pct: float,
    social_levy_pct: float,
) -&gt; Dict[str, float]:
    """
    Calculate statutory charges as percentages of revenue.
    Returns a dict with success_fee, environmental_surcharge, social_servic=
es_levy, total_statutory_deductions.
    """
    success_fee =3D revenue_lkr * success_fee_pct
    env_surcharge =3D revenue_lkr * env_surcharge_pct
    social_levy =3D revenue_lkr * social_levy_pct
    total =3D success_fee + env_surcharge + social_levy
    return {
        "success_fee": success_fee,
        "environmental_surcharge": env_surcharge,
        "social_services_levy": social_levy,
        "total_statutory_deductions": total,
    }


def _calculate_opex_lkr(opex_usd_per_year: float, fx_rate: float) -&gt; flo=
at:
    """Convert annual OPEX from USD to LKR at a given FX rate."""
    return opex_usd_per_year * fx_rate


def _apply_risk_haircut(cfads_lkr: float, risk_haircut_pct: float) -&gt; fl=
oat:
    """
    Apply risk haircut: CFADS * (1 - haircut).
    If haircut is 0.1 (10%), CFADS is multiplied by 0.9.
    """
    return cfads_lkr * (1 - risk_haircut_pct)


