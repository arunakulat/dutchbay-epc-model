class Tranche:
    """Represents a single debt tranche."""

    __slots__ =3D ("name", "rate", "principal", "years_io")

    def __init__(self, name: str, rate: float, principal: float, years_io: =
int) -&gt; None:
        self.name =3D name
        self.rate =3D float(rate)
        self.principal =3D float(principal)
        self.years_io =3D int(years_io)


def _solve_mix(p: Dict[str, Any], debt_total: float) -&gt; Dict[str, Tranch=
e]:
    """Solve tranche mix based on YAML constraints (v13 logic preserved).""=
"
    mix =3D p.get("mix", {})
    rates =3D p.get("rates", {})

    mix_lkr_max =3D _as_float(mix.get("lkr_max"), 0.0)
    mix_dfi_max =3D _as_float(mix.get("dfi_max"), 0.0)
    mix_usd_min =3D _as_float(mix.get("usd_commercial_min"), 0.0)

    r_lkr =3D _as_float(rates.get("lkr_nominal") or rates.get("lkr_min"), 0=
.0)
    r_usd =3D _as_float(rates.get("usd_nominal") or rates.get("usd_commerci=
al_min"), 0.0)
    r_dfi =3D _as_float(rates.get("dfi_nominal") or rates.get("dfi_min"), 0=
.0)

    # Base allocation
    lkr_amt =3D min(debt_total * mix_lkr_max, debt_total)
    dfi_amt =3D min(debt_total * mix_dfi_max, max(0.0, debt_total - lkr_amt=
))
    usd_amt =3D max(0.0, debt_total - lkr_amt - dfi_amt)

    # Enforce USD minimum
    min_usd_amt =3D debt_total * mix_usd_min
    if usd_amt &lt; min_usd_amt:
        need =3D min_usd_amt - usd_amt

        pull_lkr =3D min(need, lkr_amt)
        lkr_amt -=3D pull_lkr
        need -=3D pull_lkr

        if need &gt; 0:
            pull_dfi =3D min(need, dfi_amt)
            dfi_amt -=3D pull_dfi

        usd_amt =3D max(0.0, debt_total - lkr_amt - dfi_amt)

    years_io =3D int(_as_float(p.get("interest_only_years"), 0) or 0)

    return {
        "LKR": Tranche("LKR", r_lkr, lkr_amt, years_io),
        "USD": Tranche("USD", r_usd, usd_amt, years_io),
        "DFI": Tranche("DFI", r_dfi, dfi_amt, years_io),
    }


