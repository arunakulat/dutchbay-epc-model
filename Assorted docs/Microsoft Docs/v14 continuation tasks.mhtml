def summarize_all_returns(
    p: Dict[str, Any],
    cfads_series: List[float],
    debt_service_series: List[float]
) -&gt; Dict[str, Any]:
    """
    Calculate all project and equity returns metrics.
   =20
    Parameters
    ----------
    p : dict
        Configuration from YAML
    cfads_series : list of float
        Annual CFADS in LKR
    debt_service_series : list of float
        Annual debt service in LKR
   =20
    Returns
    -------
    dict
        Comprehensive returns analysis
    """
    # Extract parameters from YAML
    capex_usd =3D _as_float(_get(p, ['capex', 'usd_total'], 150000000.0)) o=
r 150000000.0
    capex_fx =3D _as_float(_get(p, ['fx', 'start_lkr_per_usd'], 300.0)) or =
300.0
   =20
    debt_ratio =3D _as_float(_get(p, ['financing', 'debt_ratio'], 0.70)) or=
 0.70
    project_discount_rate =3D _as_float(_get(p, ['returns', 'project_discou=
nt_rate'], 0.10)) or 0.10
    equity_discount_rate =3D _as_float(_get(p, ['returns', 'equity_discount=
_rate'], 0.12)) or 0.12
   =20
    total_investment =3D capex_usd * capex_fx
    debt_investment =3D total_investment * debt_ratio
    equity_investment =3D total_investment * (1 - debt_ratio)
   =20
    # Calculate project returns
    project_returns =3D calculate_project_returns(
        cfads_series,
        capex_usd,
        capex_fx,
        project_discount_rate,
        finance_rate=3Dproject_discount_rate,
        reinvest_rate=3Dequity_discount_rate
    )
   =20
    # Calculate equity returns
    equity_returns =3D calculate_equity_returns(
        cfads_series,
        debt_service_series,
        equity_investment,
        equity_discount_rate,
        finance_rate=3Dproject_discount_rate,
        reinvest_rate=3Dequity_discount_rate
    )
   =20
    return {
        'project_returns': project_returns,
        'equity_returns': equity_returns,
        'summary': {
            'total_capex_lkr': total_investment,
            'debt_investment_lkr': debt_investment,
            'equity_investment_lkr': equity_investment,
            'debt_ratio': debt_ratio,
            'equity_ratio': 1 - debt_ratio,
            'project_irr': project_returns.get('project_irr'),
            'project_npv': project_returns.get('project_npv'),
            'equity_irr': equity_returns.get('equity_irr'),
