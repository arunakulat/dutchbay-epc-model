def calculate_npv(
    cashflows: List[float],
    discount_rate: float,
    start_period: int =3D 0
) -&gt; float:
    """
    Calculate Net Present Value of cashflow series.
   =20
    Parameters
    ----------
    cashflows : list of float
        Annual cashflows (positive or negative)
    discount_rate : float
        Annual discount rate (0-1, e.g., 0.10 for 10%)
    start_period : int, default 0
        Starting period for discounting
   =20
    Returns
    -------
    float
        NPV of cashflows
    """
    if not cashflows or discount_rate &lt; -1:
        return 0.0
   =20
    npv_val =3D 0.0
    for i, cf in enumerate(cashflows):
        period =3D start_period + i
        npv_val +=3D cf / ((1 + discount_rate) ** period)
   =20
    return npv_val


def calculate_irr(
    cashflows: List[float],
    initial_guess: float =3D 0.10,
    max_iterations: int =3D 1000,
    tolerance: float =3D 1e-6
) -&gt; Optional[float]:
    """
    Calculate Internal Rate of Return using Newton-Raphson method.
   =20
    IRR is the discount rate where NPV =3D 0
   =20
    Parameters
    ----------
    cashflows : list of float
        Annual cashflows (first typically negative for investment)
    initial_guess : float, default 0.10
        Starting guess for IRR (10%)
    max_iterations : int, default 1000
        Maximum iterations for convergence
    tolerance : float, default 1e-6
        Convergence tolerance
   =20
    Returns
    -------
    float or None
        IRR (as decimal), or None if no convergence
    """
    if not cashflows or len(cashflows) &lt; 2:
        return None
   =20
    # Newton-Raphson method
    rate =3D initial_guess
   =20
    for iteration in range(max_iterations):
        # Calculate NPV and derivative (NPV')
        npv_val =3D 0.0
        npv_derivative =3D 0.0
       =20
        for i, cf in enumerate(cashflows):
            discount_factor =3D (1 + rate) ** i
            npv_val +=3D cf / discount_factor
            if i &gt; 0:
                npv_derivative -=3D i * cf / (discount_factor * (1 + rate))
       =20
        # Check convergence
        if abs(npv_val) &lt; tolerance:
            return rate
       =20
        # Avoid division by zero
        if abs(npv_derivative) &lt; 1e-10:
            return None
       =20
        # Newton-Raphson update
        rate_new =3D rate - npv_val / npv_derivative
       =20
        # Prevent extreme rates
        if rate_new &lt; -0.99 or rate_new &gt; 10.0:
            return None
       =20
        rate =3D rate_new
   =20
    # Return best estimate if not converged perfectly
    if abs(calculate_npv(cashflows, rate)) &lt; 0.01:
        return rate
   =20
    return None


def calculate_mirr(
    cashflows: List[float],
    finance_rate: float =3D 0.10,
    reinvest_rate: float =3D 0.12
) -&gt; Optional[float]:
    """
    Calculate Modified Internal Rate of Return.
   =20
    MIRR accounts for cost of financing (negative CF) and reinvestment rate=
 (positive CF)
   =20
    Parameters
    ----------
    cashflows : list of float
        Annual cashflows
    finance_rate : float, default 0.10
        Cost of financing rate (for negative cashflows)
    reinvest_rate : float, default 0.12
        Reinvestment rate (for positive cashflows)
   =20
    Returns
    -------
    float or None
        MIRR (as decimal), or None if unable to calculate
    """
    if not cashflows or len(cashflows) &lt; 2:
        return None
   =20
    n_periods =3D len(cashflows)
   =20
    # Separate positive and negative cashflows
    pv_negative =3D 0.0
    fv_positive =3D 0.0
   =20
    for i, cf in enumerate(cashflows):
        if cf &lt; 0:
            pv_negative +=3D cf / ((1 + finance_rate) ** i)
        else:
            fv_positive +=3D cf * ((1 + reinvest_rate) ** (n_periods - i - =
1))
   =20
    # Avoid division by zero or log of negative
    if pv_negative &gt;=3D 0 or fv_positive &lt;=3D 0:
        return None
   =20
    # MIRR =3D (FV_positive / |PV_negative|) ^ (1/(n-1)) - 1
    try:
        mirr =3D (fv_positive / abs(pv_negative)) ** (1 / (n_periods - 1)) =
- 1
        if isnan(mirr) or isinf(mirr):
            return None
        return mirr
    except Exception:
        return None


