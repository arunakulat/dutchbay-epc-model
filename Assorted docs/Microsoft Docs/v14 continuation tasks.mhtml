def run_sensitivity_analysis(
    output_dir: str =3D "./outputs", config: Optional[List[Dict[str, Any]]]=
 =3D None
) -&gt; pd.DataFrame:
    """
    Run comprehensive sensitivity analysis.

    Args:
        output_dir: Directory to save results
        config: Optional custom sensitivity configuration

    Returns:
        DataFrame with sensitivity results
    """
    if config is None:
        config =3D SENSITIVITY_CONFIG

    params =3D create_default_parameters()
    debt =3D create_default_debt_structure()
    results: List[Dict[str, Any]] =3D []

    try:
        base_model =3D build_financial_model(params, debt)
    except Exception as e:
        warnings.warn(f"Base model failed: {e}")
        return pd.DataFrame()

    for s in config:
        base =3D s["base"]
        param =3D s["param"]

        for val in s["stress"]:
            try:
                sp =3D ProjectParameters(**{**params.__dict__})
                sd =3D DebtStructure(**{**debt.__dict__})

                if param in ["usd_mkt_rate", "lkr_rate", "usd_dfi_rate"]:
                    setattr(sd, param, val)
                else:
                    setattr(sp, param, val)

                mr =3D build_financial_model(sp, sd)

                results.append(
                    {
                        "parameter": s["label"],
                        "base_value": base,
                        "stressed_value": val,
                        "stress_pct": (val - base) / base * 100,
                        "base_equity_irr": base_model["equity_irr"],
                        "stressed_equity_irr": mr["equity_irr"],
                        "delta_irr": mr["equity_irr"] - base_model["equity_=
irr"],
                        "delta_irr_pct": (mr["equity_irr"] - base_model["eq=
uity_irr"])
                        / base_model["equity_irr"]
                        * 100,
                        "base_npv": base_model["npv_12pct"],
                        "stressed_npv": mr["npv_12pct"],
                        "delta_npv": mr["npv_12pct"] - base_model["npv_12pc=
t"],
                        "base_dscr": base_model["min_dscr"],
                        "stressed_dscr": mr["min_dscr"],
                        "delta_dscr": mr["min_dscr"] - base_model["min_dscr=
"],
                    }
                )
            except Exception as e:
                warnings.warn(f"Sensitivity for {s['label']} at {val} faile=
d: {e}")
                continue

    df =3D pd.DataFrame(results)

    if len(df) &gt; 0:
        df.to_csv(f"{output_dir}/dutchbay_sensitivity_enhanced.csv", index=
=3DFalse)

    return df


def create_tornado_chart_data(df: pd.DataFrame) -&gt; pd.DataFrame:
    """
    Process sensitivity results for tornado chart visualization.

    Args:
        df: Sensitivity analysis DataFrame

    Returns:
        DataFrame formatted for tornado chart with absolute IRR impacts
    """
    # For each parameter, get the range of IRR impact (max - min)
    tornado_data =3D []

    for param in df["parameter"].unique():
        param_df =3D df[df["parameter"] =3D=3D param]

        max_irr =3D param_df["stressed_equity_irr"].max()
        min_irr =3D param_df["stressed_equity_irr"].min()
        base_irr =3D param_df["base_equity_irr"].iloc[0]

        tornado_data.append(
            {
                "parameter": param,
                "base_irr": base_irr,
                "low_irr": min_irr,
                "high_irr": max_irr,
                "range": max_irr - min_irr,
                "impact": abs(max_irr - min_irr),
            }
        )

    tornado_df =3D pd.DataFrame(tornado_data)
    tornado_df =3D tornado_df.sort_values("impact", ascending=3DFalse)

    return tornado_df
