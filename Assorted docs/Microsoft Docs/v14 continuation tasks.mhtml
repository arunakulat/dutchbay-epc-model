def npv(rate: float, cashflows: Sequence[float]) -&gt; float:
    """
    Classic periodic Net Present Value.
   =20
    NPV(r) =3D sum_{t=3D0..N} CF[t] / (1+r)^t
   =20
    Parameters
    ----------
    rate : float
        Discount rate (decimal, e.g., 0.12 for 12%)
    cashflows : Sequence[float]
        Cashflow series starting at t=3D0
   =20
    Returns
    -------
    float
        Net Present Value
   =20
    Notes
    -----
    - Assumes periodic (annual) cashflows
    - For irregular dates, use xnpv()
    - Rate clamped at -99.99% to avoid division errors
   =20
    Examples
    --------
    &gt;&gt;&gt; npv(0.10, [-1000, 500, 500, 500])
    243.426...
    """
    r =3D float(rate)
    if r &lt;=3D -1.0:
        r =3D -0.999999  # Avoid division by zero
   =20
    total =3D 0.0
    for t, cf in enumerate(cashflows):
        total +=3D float(cf) / ((1.0 + r) ** t)
    return total


def irr(cashflows: Sequence[float]) -&gt; Optional[float]:
    """
    Periodic Internal Rate of Return.
   =20
    Finds rate r such that NPV(r, cashflows) =3D 0.
    Uses numpy-financial if available, otherwise bisection solver.
   =20
    Parameters
    ----------
    cashflows : Sequence[float]
        Cashflow series starting at t=3D0
   =20
    Returns
    -------
    Optional[float]
        IRR as decimal (e.g., 0.18 =3D 18%), or None if not found
   =20
    Notes
    -----
    - Returns None if no sign change in NPV across search range
    - Search range: -99.99% to 500%
    - For irregular dates, use xirr()
   =20
    Edge Cases
    -----------
    - All zeros: returns 0.0
    - No sign change: returns None
    - Multiple roots: returns first found in [-0.9999, 5.0]
   =20
    Examples
    --------
    &gt;&gt;&gt; irr([-1000, 500, 500, 500])
    0.2343...
    """
    cfs =3D [float(x) for x in cashflows]
   =20
    # Try numpy-financial first
    if npf is not None:
        try:
            val =3D float(npf.irr(cfs))
            if val !=3D val:  # NaN check
                return None
            return val
        except Exception:
            pass
   =20
    # Fallback to local bisection
    return _irr_local(cfs)


def _irr_local(cashflows: Sequence[float]) -&gt; Optional[float]:
    """
    Bisection solver for IRR. Internal use only.
   =20
    Search domain: [-0.9999, 5.0] (-99.99% to 500%)
    Convergence: |NPV| &lt; 1e-10
    Max iterations: 200
    """
    if not cashflows:
        return None
   =20
    # All zeros edge case
    if all(abs(cf) &lt; 1e-12 for cf in cashflows):
        return 0.0
   =20
    lo, hi =3D -0.9999, 5.0
    f_lo =3D npv(lo, cashflows)
    f_hi =3D npv(hi, cashflows)
   =20
    # Exact root at boundary
    if abs(f_lo) &lt; 1e-12:
        return lo
    if abs(f_hi) &lt; 1e-12:
        return hi
   =20
    # No sign change =3D no root in domain
    if (f_lo &gt; 0 and f_hi &gt; 0) or (f_lo &lt; 0 and f_hi &lt; 0):
        return None
   =20
    # Bisection
    for _ in range(200):
        mid =3D (lo + hi) / 2.0
        f_mid =3D npv(mid, cashflows)
       =20
        if abs(f_mid) &lt; 1e-10:
            return mid
       =20
        # Keep sub-interval with sign change
        if (f_lo &lt; 0 and f_mid &gt; 0) or (f_lo &gt; 0 and f_mid &lt; 0)=
:
            hi, f_hi =3D mid, f_mid
        else:
            lo, f_lo =3D mid, f_mid
   =20
    return (lo + hi) / 2.0


