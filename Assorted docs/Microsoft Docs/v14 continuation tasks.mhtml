def _compute_depreciation_schedule(
    capex_total: Optional[float],
    depreciation_years: int,
    enhanced_capital_allowance_pct: float,
) -&gt; List[float]:
    """
    Build a straight-line depreciation schedule over depreciation_years.
    enhanced_capital_allowance_pct allows &gt;100% total depreciation (e.g.=
 150% of capex).
    """
    if capex_total is None or depreciation_years &lt;=3D 0:
        return []
    total_depreciable =3D capex_total * enhanced_capital_allowance_pct
    annual =3D total_depreciable / depreciation_years
    return [annual] * depreciation_years


def calculate_tax_with_interest_shield(
    pretax_cfads: float,
    corporate_tax_rate: float,
    capex_total: Optional[float],
    depreciation_years: int,
    interest_expense_lkr: float,
    year_index: int,
    tax_holiday_years: int =3D 0,
    tax_holiday_start_year: int =3D 1,
    enhanced_capital_allowance_pct: float =3D 1.0,
) -&gt; Tuple[float, float]:
    """
    Calculate BOI-compliant tax with interest shield for a given year.

    Parameters:
    -----------
    - pretax_cfads: CFADS before tax and before interest shield
    - corporate_tax_rate: decimal, e.g. 0.24 for 24%
    - capex_total: total project capex (LKR) or None if not applicable
    - depreciation_years: number of years to depreciate capex
    - interest_expense_lkr: interest for this year (LKR)
    - year_index: 0-based index (0 for first year)
    - tax_holiday_years: duration of tax holiday (years)
    - tax_holiday_start_year: 1-based year when holiday starts
    - enhanced_capital_allowance_pct: multiplier for total depreciation (e.=
g. 1.5 for 150%)

    Returns:
    --------
    (tax_lkr, depreciation_for_year_lkr)
    """
    if corporate_tax_rate &lt;=3D 0.0:
        return 0.0, 0.0

    current_year =3D year_index + 1

    # Determine whether the year is within the tax holiday window.
    in_holiday =3D False
    if tax_holiday_years &gt; 0:
        start =3D tax_holiday_start_year
        end =3D start + tax_holiday_years - 1
        in_holiday =3D start &lt;=3D current_year &lt;=3D end

    # If in holiday, no tax, but we still track depreciation for info.
    if capex_total is None or depreciation_years &lt;=3D 0:
        depreciation_schedule =3D []
    else:
        depreciation_schedule =3D _compute_depreciation_schedule(
            capex_total,
            depreciation_years,
            enhanced_capital_allowance_pct,
        )

    if year_index &lt; len(depreciation_schedule):
        depreciation_for_year =3D depreciation_schedule[year_index]
    else:
        depreciation_for_year =3D 0.0

    if in_holiday:
        # During BOI tax holiday, we treat tax as zero, regardless of taxab=
le income.
        return 0.0, depreciation_for_year

    # Outside tax holiday, apply corporate tax with interest deductibility.
    taxable_income =3D pretax_cfads - depreciation_for_year - interest_expe=
nse_lkr
    taxable_income =3D max(0.0, taxable_income)
    tax =3D taxable_income * corporate_tax_rate
    return tax, depreciation_for_year


