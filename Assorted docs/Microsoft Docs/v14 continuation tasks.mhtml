                'cvar': float,
                'var_label': str,
                'cvar_label': str
            }
        """
        sorted_returns =3D np.sort(returns)
        var_index =3D int((1 - self.confidence_level) * len(returns))
       =20
        var =3D sorted_returns[var_index]
        cvar =3D sorted_returns[:var_index].mean()
       =20
        return {
            'var': var,
            'cvar': cvar,
            'var_label': f"VaR({int(self.confidence_level*100)}%)",
            'cvar_label': f"CVaR({int(self.confidence_level*100)}%)",
            'return_type': return_type,
            'confidence': self.confidence_level
        }
   =20
    def percentile_analysis(
