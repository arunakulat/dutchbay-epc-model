def _annuity_schedule(tr: Tranche, amort_years: int) -&gt; List[Tuple[float=
, float, float]]:
    """
    Build annuity schedule.

    Returns rows as (interest, principal, total_service).
    """
    n =3D amort_years
    bal =3D tr.principal
    rows: List[Tuple[float, float, float]] =3D []

    # Interest-only period
    for _ in range(tr.years_io):
        interest =3D bal * tr.rate
        rows.append((interest, 0.0, interest))

    # Amortization period
    if n &gt; 0:
        pmt =3D _pmt(tr.rate, n, bal)
        for _ in range(n):
            interest =3D bal * tr.rate
            principal =3D max(0.0, pmt - interest)
            bal =3D max(0.0, bal - principal)
            rows.append((interest, principal, interest + principal))

    return rows


def _sculpted_schedule(
    tranches: Dict[str, Tranche],
    amort_years: int,
    cfads: List[float],
    dscr_target: float,
) -&gt; Dict[str, List[Tuple[float, float, float]]]:
    """
    Build sculpted schedule targeting DSCR.

    Returns mapping: tranche_name -&gt; list of (interest, principal, total=
_service).
    """
    obals =3D {k: tr.principal for k, tr in tranches.items()}
    schedules: Dict[str, List[Tuple[float, float, float]]] =3D {k: [] for k=
 in tranches}
    io_years =3D max(tr.years_io for tr in tranches.values())
    year_index =3D 0

    # Interest-only period
    for _ in range(io_years):
        for k, tr in tranches.items():
            bal =3D obals[k]
            interest =3D bal * tr.rate
            schedules[k].append((interest, 0.0, interest))
        year_index +=3D 1

    # Amortization period
    for _ in range(amort_years):
        if cfads:
            cf =3D cfads[year_index] if year_index &lt; len(cfads) else cfa=
ds[-1]
        else:
            cf =3D 0.0

        target_service =3D max(0.0, cf / dscr_target) if dscr_target &gt; 0=
 else 0.0

        interest_map =3D {k: obals[k] * tranches[k].rate for k in tranches}
        total_interest =3D sum(interest_map.values())
        principal_total =3D max(0.0, target_service - total_interest)

        total_bal =3D sum(obals.values()) or 1.0
        for k, tr in tranches.items():
            bal =3D obals[k]
            prorata =3D bal / total_bal if total_bal &gt; 0 else 0.0
            principal_k =3D min(bal, principal_total * prorata)
            interest_k =3D interest_map[k]
            obals[k] =3D max(0.0, bal - principal_k)
            schedules[k].append((interest_k, principal_k, interest_k + prin=
cipal_k))

        year_index +=3D 1

    return schedules


