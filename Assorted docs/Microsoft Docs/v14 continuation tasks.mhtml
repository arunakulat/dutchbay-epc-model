        """High-level helper used by ScenarioAnalytics.

        - Always writes <code>summary_df</code> and <code>timeseries_df</co=
de> to separate sheets.
        - Optionally adds lighter, board-focused views when the expected
          columns are present (DSCR and IRR views).
        - Autofits all columns and saves the workbook.

        This is the main entry point for the analytics pipeline.
        """
        logger.info(
            "ExcelExporter: exporting summary + timeseries to %s",
            self.output_path,
        )
        self.write_scenario_summary(summary_df, sheet_name=3Dsummary_sheet)
        self.write_scenario_timeseries(timeseries_df, sheet_name=3Dtimeseri=
es_sheet)

        if add_board_views:
            self._add_board_friendly_views(summary_df, timeseries_df)

        # Layout polish and save
        self.autofit_all()
        self.save()

    # ------------------------------------------------------------------
    # Board-pack views
    # ------------------------------------------------------------------
    def _add_board_friendly_views(
        self,
        summary_df: pd.DataFrame,
        timeseries_df: pd.DataFrame,
    ) -&gt; None:
        """Add optional DSCR / IRR views if the data supports them.

        This method is deliberately defensive: if columns are missing, it l=
ogs
        and quietly returns rather than raising, so analytics tests and
        pipelines are not brittle.
        """
        writer =3D self._ensure_writer()

        # DSCR by year / period, per scenario, if available
        if {"scenario_name", "dscr"}.issubset(timeseries_df.columns):
            try:
                dscr_cols =3D [
                    c
                    for c in timeseries_df.columns
                    if c in {"scenario_name", "year", "period", "dscr"}
                ]
                dscr_view =3D timeseries_df[dscr_cols].copy()

                # Prefer a tidy "Year" column for the board
                if "year" in dscr_view.columns:
                    dscr_view.rename(columns=3D{"year": "Year"}, inplace=3D=
True)
                elif "period" in dscr_view.columns:
                    dscr_view.rename(columns=3D{"period": "Period"}, inplac=
e=3DTrue)

                dscr_view.to_excel(writer, sheet_name=3D"DSCR_View", index=
=3DFalse)
            except Exception as exc:
                logger.warning("ExcelExporter: DSCR view export failed: %s"=
, exc)

        # IRR summary view if IRR columns exist
        irr_candidates =3D [c for c in summary_df.columns if "irr" in str(c=
).lower()]
        if irr_candidates:
            try:
                irr_view =3D summary_df[["scenario_name", *irr_candidates]]=
.copy()
                irr_view.to_excel(writer, sheet_name=3D"IRR_View", index=3D=
False)
            except Exception as exc:
                logger.warning("ExcelExporter: IRR view export failed: %s",=
 exc)

    # ------------------------------------------------------------------
    # Layout helpers
    # ------------------------------------------------------------------
    def autofit_all(self) -&gt; None:
        """Best-effort column auto-fit for all sheets.

        If <code>openpyxl</code> is not available or something unexpected h=
appens,
        the error is logged and ignored rather than bubbling up.
        """
        if self._writer is None:
            return

        try:
            workbook =3D self._writer.book  # type: ignore[attr-defined]
        except Exception as exc:  # pragma: no cover - very defensive
            logger.warning("ExcelExporter: unable to access workbook: %s", =
exc)
            return

        try:
            from openpyxl.utils import get_column_letter
        except Exception as exc:  # pragma: no cover - openpyxl missing
            logger.warning("ExcelExporter: openpyxl not available for autof=
it: %s", exc)
            return

        for ws in workbook.worksheets:
            for column_cells in ws.columns:
                # Compute a reasonable width based on the longest value.
                try:
                    max_length =3D max(
                        len(str(cell.value)) if cell.value is not None else=
 0
                        for cell in column_cells
                    )
                except ValueError:
                    # Empty column
                    continue

                adjusted_width =3D max_length + 2
                col_letter =3D get_column_letter(column_cells[0].column)
                ws.column_dimensions[col_letter].width =3D adjusted_width


