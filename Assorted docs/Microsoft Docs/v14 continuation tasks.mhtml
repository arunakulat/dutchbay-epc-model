def main(argv: Iterable[str]) -&gt; int:
    import argparse

    parser =3D argparse.ArgumentParser(description=3D"Run v14 scenario anal=
ytics.")
    parser.add_argument(
        "--scenarios-dir",
        default=3D"scenarios",
