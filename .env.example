# DutchBay EPC model - environment template (issue #845).
#
# Copy to .env and edit:  cp .env.example .env
# docker-compose.yml reads this via env_file. Defaults below are LOCAL-COMPOSE
# oriented (Redis at redis://redis:6379, development posture). On Fly.io the
# non-secret values live in fly.toml [env] and the SECRETS are set with
# `fly secrets set` (see scripts/provision_web_secrets.py) - never committed.
#
# Every variable is documented with: purpose, default, and SECRET vs non-secret.
# There are exactly 14 variables, grouped auth / jobs / api.
#
# SECRET handling: for the three SECRET variables below, keep real values OUT of
# version control. Locally, put them in your (git-ignored) .env only. For Fly,
# provision them with `fly secrets set` via scripts/provision_web_secrets.py.

# =============================================================================
# AUTH  (app/api/auth.py)
# Fail-closed when DUTCHBAY_ENV in {production, prod}; permissive otherwise.
# =============================================================================

# Deployment posture selector. Unset or "development" => permissive LOCAL posture
# (issuer/audience optional, weak-secret checks relaxed). "production"/"prod" =>
# hardened posture (issuer + audience MANDATORY, JWT secret strength enforced).
# Default: development (unset). Non-secret. Local compose keeps this development.
DUTCHBAY_ENV=development

# HMAC signing secret for JWTs. Required; a missing/empty value rejects every
# login, and in production a known-insecure placeholder (e.g. "changeme") is
# refused (500). SECRET - never commit a real value; on Fly set via
# `fly secrets set` (scripts/provision_web_secrets.py). No production default.
DUTCHBAY_JWT_SECRET=changeme-generate-a-strong-random-secret

# Authorized users as "user:<pbkdf2-hash>,user2:<hash>". Absent => no user can
# authenticate. Hashes are produced by app.api.auth.hash_password (never store a
# plaintext password here). SECRET - on Fly set via `fly secrets set`
# (scripts/provision_web_secrets.py). Default: unset (no users).
DUTCHBAY_API_USERS=analyst:<pbkdf2-hash-from-app.api.auth.hash_password>

# JWT "iss" (issuer) binding. MANDATORY in production (unset => 500); optional in
# development. Non-secret. Default: unset. Example below matches fly.toml [env].
DUTCHBAY_JWT_ISSUER=dutchbay-epc-model

# JWT "aud" (audience) binding. MANDATORY in production (unset => 500); optional in
# development. Non-secret. Default: unset. Example below matches fly.toml [env].
DUTCHBAY_JWT_AUDIENCE=dutchbay-web

# =============================================================================
# JOBS  (app/jobs/config.py)
# Async ERA5/wind job path: arq worker + Redis-backed shared job store.
# =============================================================================

# Job backend selector: "memory" (in-process BackgroundTasks + in-memory store)
# or "redis" (durable, cross-process arq queue + RedisJobStore). Default: memory.
# Non-secret. Deploy/compose use redis.
DUTCHBAY_JOBS_BACKEND=redis

# Redis DSN, shared by the API (producer) and the arq worker (consumer). Only
# consulted when DUTCHBAY_JOBS_BACKEND=redis. Default: redis://localhost:6379.
# Local compose uses the compose-network host "redis". On Fly the managed Redis
# DSN carries a password => SECRET, set via `fly secrets set`
# (scripts/provision_web_secrets.py).
DUTCHBAY_REDIS_URL=redis://redis:6379

# Named arq queue the API produces to and the worker consumes from. Both sides
# must agree. Default: dutchbay:wind_jobs. Non-secret.
DUTCHBAY_JOBS_QUEUE=dutchbay:wind_jobs

# Max job records retained in the in-memory store (terminal jobs evict first).
# Default: 1000. Non-secret.
DUTCHBAY_JOBS_MAX_RETAINED=1000

# TTL (seconds) applied to Redis job records; 0 disables expiry. Default: 86400
# (24h). Non-secret.
DUTCHBAY_JOBS_TTL_SECONDS=86400

# Max SSE polls before a progress stream self-closes (x poll interval = max
# stream lifetime). Default: 600. Non-secret.
DUTCHBAY_SSE_MAX_POLLS=600

# Seconds between SSE polls while a job is non-terminal. Default: 0.5. Non-secret.
DUTCHBAY_SSE_POLL_INTERVAL=0.5

# =============================================================================
# API  (app/api/config.py)
# Operational limits for the synchronous /cases* compute routes.
# =============================================================================

# Wall-clock ceiling (seconds) for the synchronous /cases* compute routes; bounds
# the client wait, not the computation. Default: 120. Non-secret.
DUTCHBAY_SYNC_ROUTE_TIMEOUT=120

# Max concurrent synchronous /cases* computations; excess sheds load with 503.
# <= 0 disables the explicit bound. Default: 8. Non-secret.
DUTCHBAY_SYNC_ROUTE_MAX_CONCURRENCY=8
