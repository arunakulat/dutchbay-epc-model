"""
DutchBay Cashflow v14 Tax Module (Refactored)
==============================================

Canonical tax calculation engine for CFADS.
- TaxProfile: immutable, frozen dataclass bundling all tax config
- build_tax_profile(): factory to construct TaxProfile with pre-computed depreciation
- calculate_tax_for_year(): simplified 4-param tax calculation

Go-with-the-Flow v3.0 Compliant:
  - Full type hints (mypy --strict)
  - No bare dicts in public interfaces
  - Immutable dataclasses
  - Explicit, testable logic

Author: DutchBay Finance Team
Date: December 9, 2025
"""

from __future__ import annotations

import logging
from dataclasses import dataclass
from typing import List, Optional, Sequence, Tuple

logger = logging.getLogger(__name__)


@dataclass(frozen=True)
class TaxProfile:
    """
    Canonical, immutable tax configuration for the entire project.

    This dataclass bundles all tax-related configuration and the
    pre-computed depreciation schedule. It is frozen (immutable) to
    ensure audit-safe behavior and prevent accidental mutation.

    Attributes
    ----------
    corporate_tax_rate : float
        Headline corporate income tax rate, as decimal.
        Example: 0.24 for 24%.
        Valid range: 0.0 to 1.0.

    depreciation_schedule_lkr : Sequence[float]
        Pre-computed annual depreciation amounts (LKR) for each project year.
        Length should match project_life_years (padded with zeros if needed).
        Sum of all values = capex_depreciable_lkr * enhancement_factor.

    tax_holiday_years : int
        Number of consecutive years with zero income tax (default 0 = no holiday).
        During these years, tax is always zero, but depreciation still accrues.

    tax_holiday_start_year : int
        1-based year number when tax holiday begins (default 1 = year 1).
        If tax_holiday_years=3 and tax_holiday_start_year=1, years 1-3 are
        in the holiday window.

    apply_interest_shield : bool
        Whether interest expense reduces taxable income (default True).
        In Sri Lanka BOI regime, interest is typically deductible.

    Notes
    -----
    - All rates are stored as decimals (0.24 = 24%), not percentages.
    - Tax holiday is 1-based; internally converted to 0-based for calculations.
    - This dataclass is frozen; modifications require creating a new instance.
    """

    corporate_tax_rate: float
    depreciation_schedule_lkr: Sequence[float]
    tax_holiday_years: int = 0
    tax_holiday_start_year: int = 1
    apply_interest_shield: bool = True

    def __post_init__(self) -> None:
        """Validate all fields on construction."""
        if not (0.0 <= self.corporate_tax_rate <= 1.0):
            raise ValueError(
                f"corporate_tax_rate must be 0.0–1.0; got {self.corporate_tax_rate}"
            )
        if self.tax_holiday_years < 0:
            raise ValueError(
                f"tax_holiday_years must be >= 0; got {self.tax_holiday_years}"
            )
        if self.tax_holiday_start_year < 1:
            raise ValueError(
                f"tax_holiday_start_year must be >= 1 (1-based); got {self.tax_holiday_start_year}"
            )

    def is_in_tax_holiday(self, year_index: int) -> bool:
        """
        Check if a year (0-based index) falls within the tax holiday window.

        Tax holiday spans from tax_holiday_start_year (1-based) for
        tax_holiday_years consecutive years.

        Parameters
        ----------
        year_index : int
            Zero-based year index (0 = first operating year).

        Returns
        -------
        bool
            True if year_index is within the holiday window, False otherwise.

        Examples
        --------
        If tax_holiday_start_year=1 and tax_holiday_years=3:
        - is_in_tax_holiday(0) → True  (year 1)
        - is_in_tax_holiday(1) → True  (year 2)
        - is_in_tax_holiday(2) → True  (year 3)
        - is_in_tax_holiday(3) → False (year 4)

        If tax_holiday_start_year=5 and tax_holiday_years=2:
        - is_in_tax_holiday(3) → False (year 4)
        - is_in_tax_holiday(4) → True  (year 5)
        - is_in_tax_holiday(5) → True  (year 6)
        - is_in_tax_holiday(6) → False (year 7)
        """
        if self.tax_holiday_years == 0:
            return False

        current_year = year_index + 1  # Convert to 1-based
        end_year = self.tax_holiday_start_year + self.tax_holiday_years - 1
        return self.tax_holiday_start_year <= current_year <= end_year


def build_tax_profile(
    corporate_tax_rate: float,
    capex_depreciable_lkr: Optional[float],
    depreciation_years: int,
    enhanced_capital_allowance_pct: float,
    tax_holiday_years: int = 0,
    tax_holiday_start_year: int = 1,
    project_life_years: int = 25,
    apply_interest_shield: bool = True,
) -> TaxProfile:
    """
    Construct a TaxProfile by computing the full depreciation schedule once.

    This factory function is called once per project (typically in
    _prepare_cashflow_context()) and the resulting TaxProfile is reused
    for all year-by-year tax calculations. This avoids recomputing
    the depreciation schedule in every iteration.

    Parameters
    ----------
    corporate_tax_rate : float
        Tax rate as decimal (e.g., 0.24 for 24%).
        Valid range: 0.0 to 1.0.

    capex_depreciable_lkr : Optional[float]
        Depreciable capex base in LKR (tax-eligible portion of total capex).
        If None or <= 0, depreciation is disabled (schedule is all zeros).

    depreciation_years : int
        Straight-line depreciation horizon in years (e.g., 20).
        If <= 0, depreciation is disabled.

    enhanced_capital_allowance_pct : float
        Multiplier for depreciable capex under BOI rules.
        Example: 1.0 (no enhancement), 1.2 (120% of capex).
        Must be >= 1.0; applied as capex * factor before depreciation.

    tax_holiday_years : int, optional
        Number of full years with zero tax (default 0 = no holiday).
        During these years, tax = 0 but depreciation still accrues.

    tax_holiday_start_year : int, optional
        1-based year when tax holiday begins (default 1 = year 1).
        Must be >= 1.

    project_life_years : int, optional
        Total project life for schedule padding/trimming (default 25).
        The depreciation schedule is padded with zeros or trimmed to
        this length.

    apply_interest_shield : bool, optional
        Whether interest expense reduces taxable income (default True).
        In Sri Lanka BOI regime, interest is typically deductible.

    Returns
    -------
    TaxProfile
        Frozen dataclass with pre-computed depreciation schedule.

    Raises
    ------
    ValueError
        If corporate_tax_rate not in [0.0, 1.0], or tax_holiday_start_year < 1.

    Examples
    --------
    >>> profile = build_tax_profile(
    ...     corporate_tax_rate=0.24,
    ...     capex_depreciable_lkr=100_000_000.0,
    ...     depreciation_years=20,
    ...     enhanced_capital_allowance_pct=1.0,
    ...     project_life_years=25,
    ... )
    >>> profile.corporate_tax_rate
    0.24
    >>> len(profile.depreciation_schedule_lkr)
    25
    """
    # Compute depreciation schedule once
    if (
        capex_depreciable_lkr is None
        or capex_depreciable_lkr <= 0.0
        or depreciation_years <= 0
    ):
        depreciation_schedule: List[float] = []
    else:
        total_depreciable = capex_depreciable_lkr * enhanced_capital_allowance_pct
        annual_dep = total_depreciable / float(depreciation_years)
        depreciation_schedule = [annual_dep] * depreciation_years

    # Pad to project life
    if len(depreciation_schedule) < project_life_years:
        depreciation_schedule = depreciation_schedule + [0.0] * (
            project_life_years - len(depreciation_schedule)
        )
    elif len(depreciation_schedule) > project_life_years:
        depreciation_schedule = depreciation_schedule[:project_life_years]

    return TaxProfile(
        corporate_tax_rate=corporate_tax_rate,
        depreciation_schedule_lkr=depreciation_schedule,
        tax_holiday_years=tax_holiday_years,
        tax_holiday_start_year=tax_holiday_start_year,
        apply_interest_shield=apply_interest_shield,
    )


def calculate_tax_for_year(
    profile: TaxProfile,
    pretax_cfads_lkr: float,
    interest_expense_lkr: float,
    year_index: int,
) -> Tuple[float, float]:
    """
    Calculate tax and depreciation for a single year using a TaxProfile.

    This is the new canonical tax function. It replaces the old
    calculate_tax_with_interest_shield() in the year-by-year loop.

    The function implements Sri Lanka BOI tax rules:
    1. During tax holiday: tax = 0 (but depreciation accrues)
    2. Outside holiday: taxable income = pretax_cfads - depreciation - interest
    3. Tax = taxable income × corporate_tax_rate (floored at 0)

    Parameters
    ----------
    profile : TaxProfile
        Pre-built tax configuration with pre-computed depreciation schedule.

    pretax_cfads_lkr : float
        CFADS before tax and interest shield (LKR).
        This is the operating cash flow = revenue - opex - statutory.

    interest_expense_lkr : float
        Interest expense for the year (LKR).
        If profile.apply_interest_shield is True, this reduces taxable income.

    year_index : int
        Zero-based year index (0 = first operating year).

    Returns
    -------
    Tuple[float, float]
        (tax_lkr, depreciation_for_year_lkr)
        - tax_lkr: corporate income tax for the year (LKR)
        - depreciation_for_year_lkr: depreciation amount used (LKR)

    Notes
    -----
    - During tax holiday, tax = 0 but depreciation still "consumed" for accounting.
    - Loss carry-forward is not handled at this level; implement upstream if needed.
    - Taxable income is floored at zero (no negative tax).
    - If year_index >= depreciation schedule length, depreciation = 0.

    Examples
    --------
    >>> profile = TaxProfile(
    ...     corporate_tax_rate=0.24,
    ...     depreciation_schedule_lkr=[5_000_000.0] * 25,
    ...     tax_holiday_years=3,
    ...     tax_holiday_start_year=1,
    ... )
    >>> # Year 1 (index 0): in tax holiday
    >>> tax, dep = calculate_tax_for_year(
    ...     profile=profile,
    ...     pretax_cfads_lkr=50_000_000.0,
    ...     interest_expense_lkr=10_000_000.0,
    ...     year_index=0,
    ... )
    >>> tax
    0.0
    >>> dep
    5000000.0
    >>> # Year 4 (index 3): after holiday
    >>> tax, dep = calculate_tax_for_year(
    ...     profile=profile,
    ...     pretax_cfads_lkr=50_000_000.0,
    ...     interest_expense_lkr=10_000_000.0,
    ...     year_index=3,
    ... )
    >>> tax
    8400000.0  # (50M - 5M - 10M) * 0.24
    """
    # Get depreciation for this year (pad with 0 if schedule is short)
    if year_index < len(profile.depreciation_schedule_lkr):
        depreciation_for_year = profile.depreciation_schedule_lkr[year_index]
    else:
        depreciation_for_year = 0.0

    # Tax holiday check
    if profile.is_in_tax_holiday(year_index):
        return 0.0, depreciation_for_year

    # Taxable income calculation
    taxable_income = pretax_cfads_lkr - depreciation_for_year
    if profile.apply_interest_shield:
        taxable_income -= interest_expense_lkr

    # Floor at zero (no losses carried forward at this level)
    taxable_income = max(0.0, taxable_income)

    # Apply tax rate
    tax = taxable_income * profile.corporate_tax_rate

    return tax, depreciation_for_year


# Backward compatibility: old function signature (deprecated)
def _compute_depreciation_schedule(
    capex_total: Optional[float],
    depreciation_years: int,
    enhanced_capital_allowance_pct: float,
) -> List[float]:
    """
    Build a straight-line depreciation schedule over depreciation_years.

    **DEPRECATED**: Use build_tax_profile() and TaxProfile instead.

    If capex_total is None or depreciation_years <= 0, an empty schedule
    is returned.

    Parameters
    ----------
    capex_total : Optional[float]
        Depreciable base in LKR.

    depreciation_years : int
        Straight-line horizon.

    enhanced_capital_allowance_pct : float
        Multiplier (e.g., 1.2 for 120%).

    Returns
    ------
    List[float]
        Annual depreciation amounts (LKR).
    """
    if capex_total is None or depreciation_years <= 0:
        return []

    total_depreciable = capex_total * enhanced_capital_allowance_pct
    annual = total_depreciable / float(depreciation_years)
    return [annual] * depreciation_years


# Backward compatibility: old function signature (deprecated)
def calculate_tax_with_interest_shield(
    pretax_cfads: float,
    corporate_tax_rate: float,
    capex_depreciable_lkr: Optional[float],
    depreciation_years: int,
    interest_expense_lkr: float,
    year_index: int,
    tax_holiday_years: int = 0,
    tax_holiday_start_year: int = 1,
    enhanced_capital_allowance_pct: float = 1.0,
    precomputed_depr_schedule: Optional[Sequence[float]] = None,
) -> Tuple[float, float]:
    """
    Calculate BOI-compliant tax with interest shield for a given year.

    **DEPRECATED**: Use build_tax_profile() + calculate_tax_for_year() instead.

    This function is kept for backward compatibility during migration.
    It reconstructs behavior by calling the new API internally.
    """
    # Build profile on-the-fly (not efficient; use build_tax_profile instead)
    if precomputed_depr_schedule is not None:
        profile = TaxProfile(
            corporate_tax_rate=corporate_tax_rate,
            depreciation_schedule_lkr=precomputed_depr_schedule,
            tax_holiday_years=tax_holiday_years,
            tax_holiday_start_year=tax_holiday_start_year,
            apply_interest_shield=True,
        )
    else:
        profile = build_tax_profile(
            corporate_tax_rate=corporate_tax_rate,
            capex_depreciable_lkr=capex_depreciable_lkr,
            depreciation_years=depreciation_years,
            enhanced_capital_allowance_pct=enhanced_capital_allowance_pct,
            tax_holiday_years=tax_holiday_years,
            tax_holiday_start_year=tax_holiday_start_year,
            project_life_years=25,  # Default
        )

    return calculate_tax_for_year(
        profile=profile,
        pretax_cfads_lkr=pretax_cfads,
        interest_expense_lkr=interest_expense_lkr,
        year_index=year_index,
    )


__all__ = [
    "TaxProfile",
    "build_tax_profile",
    "calculate_tax_for_year",
    "_compute_depreciation_schedule",  # Deprecated
    "calculate_tax_with_interest_shield",  # Deprecated
]
