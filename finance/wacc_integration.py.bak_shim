"""finance.wacc_integration

Compatibility shim for the V14 finance stack.

Why this exists
---------------
Some v14 equity modules import ``finance.wacc_integration`` for a small, additive
WACC calculation surface (WaccResult + calculate_wacc). In some repo layouts the
implementation lived elsewhere (e.g., finance/wacc/wacc_v14.py). This shim keeps
imports stable and prevents ModuleNotFoundError at import time.

GWTF posture
------------
- Additive only: nothing changes unless a caller explicitly calls calculate_wacc.
- No global state.
- Deterministic behaviour suitable for lender-grade analytics.

Units
-----
All rates are decimals (e.g., 0.10 = 10%).
"""

from __future__ import annotations

from dataclasses import dataclass, field
from typing import Any, Dict, Optional


@dataclass(frozen=True)
class WaccResult:
    """Minimal WACC result container used by the equity layer."""

    mode: str = "capm"

    # Core outputs
    wacc_nominal: float = 0.0
    wacc_real: Optional[float] = None
    wacc_prudential: float = 0.0

    # Decomposition (useful for reporting/debugging)
    risk_free_rate: float = 0.0
    market_risk_premium: float = 0.0
    asset_beta: float = 0.0
    equity_beta_levered: float = 0.0

    cost_of_equity: float = 0.0
    cost_of_debt_pretax: float = 0.0
    cost_of_debt_aftertax: float = 0.0

    debt_to_value: float = 0.0
    equity_to_value: float = 1.0
    tax_rate: float = 0.0

    inflation_rate: Optional[float] = None
    prudential_spread_bps: int = 0

    meta: Dict[str, Any] = field(default_factory=dict)


def calculate_wacc(
    *,
    risk_free_rate: float,
    market_risk_premium: float,
    asset_beta: float,
    cost_of_debt_pretax: float,
    tax_rate: float,
    debt_to_value: float,
    inflation_rate: Optional[float] = None,
    prudential_spread_bps: int = 0,
    mode: str = "capm",
) -> WaccResult:
    """Compute nominal (and optional real) WACC using CAPM and target D/V.

    Parameters
    ----------
    risk_free_rate, market_risk_premium, asset_beta:
        CAPM inputs.
    cost_of_debt_pretax:
        Pre-tax cost of debt (nominal).
    tax_rate:
        Corporate tax rate for the interest tax shield.
    debt_to_value:
        Target gearing D/V.
    inflation_rate:
        Optional inflation rate to compute real WACC.
    prudential_spread_bps:
        Optional prudential uplift in basis points.
    """

    dv = float(debt_to_value)
    dv = max(0.0, min(1.0, dv))
    ev = 1.0 - dv

    # Avoid division by zero for 100% debt assumptions.
    if ev <= 0.0:
        de = 0.0
    else:
        de = dv / ev

    tc = float(tax_rate)

    # Re-lever asset beta to equity beta: Be = Bu * [1 + (1 - Tc) * (D/E)]
    equity_beta = float(asset_beta) * (1.0 + (1.0 - tc) * de)

    # Cost of equity via CAPM: Ke = Rf + Be * MRP
    ke = float(risk_free_rate) + equity_beta * float(market_risk_premium)

    kd = float(cost_of_debt_pretax)
    kd_after = kd * (1.0 - tc)

    wacc_nom = ev * ke + dv * kd_after

    uplift = float(prudential_spread_bps) / 10000.0
    wacc_prud = wacc_nom + uplift

    if inflation_rate is not None:
        inf = float(inflation_rate)
        try:
            wacc_real = (1.0 + wacc_nom) / (1.0 + inf) - 1.0
        except ZeroDivisionError:
            wacc_real = None
    else:
        wacc_real = None

    return WaccResult(
        mode=str(mode),
        wacc_nominal=float(wacc_nom),
        wacc_real=wacc_real,
        wacc_prudential=float(wacc_prud),
        risk_free_rate=float(risk_free_rate),
        market_risk_premium=float(market_risk_premium),
        asset_beta=float(asset_beta),
        equity_beta_levered=float(equity_beta),
        cost_of_equity=float(ke),
        cost_of_debt_pretax=float(kd),
        cost_of_debt_aftertax=float(kd_after),
        debt_to_value=float(dv),
        equity_to_value=float(ev),
        tax_rate=float(tc),
        inflation_rate=float(inflation_rate) if inflation_rate is not None else None,
        prudential_spread_bps=int(prudential_spread_bps),
        meta={},
    )
