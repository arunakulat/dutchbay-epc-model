from __future__ import annotations

from pathlib import Path
from typing import Any, Sequence

from analytics.contracts_v14 import CasperResult, MonteCarloResult, ScenarioResult, TailRiskSnapshot
from analytics.contracts_v14 import build_cashflow_result_from_annual_rows
from analytics.pipeline_v14 import _build_tranche_debt_profile, _build_debt_covenant_snapshot, _build_wacc_contract
from analytics.scenario_loader import load_scenario_config
from analytics.core.metrics import calculate_scenario_kpis
from finance.cashflow_v14 import build_annual_rows
from finance.debt_v14 import plan_debt
from finance.wacc_v14 import compute_wacc_from_config

def evaluate_with_casper_tail_risk(
    *,
    config_path: str,
    monte_carlo_config_path: str | None = None,
    sensitivity_suite: Any | None = None,
    metric: str = "project_irr",
    confidence: float = 0.9,
    validation_mode: str = "strict",
    validation_modules: Sequence[str] | None = None,
) -> CasperResult:
    """
    Run full scenario evaluation with tail-risk Monte Carlo analysis.
    Returns a CasperResult dataclass including scenario, baseline_kpis, sensitivities, monte_carlo, and tail-risk metadata.
    """
    # 1. Load scenario config and run base scenario pipeline
    cfg: dict[str, Any] = load_scenario_config(Path(config_path))
    annual_rows = build_annual_rows(cfg)
    debt_result = plan_debt(annual_rows=annual_rows, config=cfg)
    cashflow_contract = build_cashflow_result_from_annual_rows(config=cfg, annual_rows=annual_rows)
    wacc_dict = compute_wacc_from_config(cfg)
    discount_rate_for_kpis = 0.10
    kpis = calculate_scenario_kpis(
        config=cfg,
        annual_rows=annual_rows,
        debt_result=debt_result,
        discount_rate=discount_rate_for_kpis,
    )
    wacc_contract = _build_wacc_contract(wacc_dict)
    debt_profile = _build_tranche_debt_profile(cfg, debt_result)
    debt_covenants = _build_debt_covenant_snapshot(cfg, debt_result)
    scenario_name = str(cfg.get("scenario_name", Path(config_path).stem))
    scenario_result = ScenarioResult(
        scenario_name=scenario_name,
        config_path=str(config_path),
        project_npv=float(kpis.get("project_npv", 0.0)),
        project_irr=float(kpis.get("project_irr", 0.0)),
        dscr_series=list(debt_result.get("dscr_series") or []),
        min_dscr=float(debt_result.get("min_dscr") or 0.0),
        max_debt_usd=float(kpis.get("max_debt_usd", 0.0)),
        wacc=wacc_contract if wacc_contract is not None else None,
        discount_rate_used=discount_rate_for_kpis,
        wacc_label=(wacc_dict.get("mode") if wacc_dict else None),
        wacc_is_real=(bool(wacc_dict.get("wacc_real") is not None) if wacc_dict else None),
        validation_mode=validation_mode,
        config=cfg,
        annual_rows=annual_rows,
        debt_result=debt_result,
        kpis=kpis,
        cashflow=cashflow_contract,
        equity_performance=None,
        debt_profile=debt_profile,
        debt_covenants=debt_covenants,
    )
    # Ensure DSCR alias present
    kpis.setdefault("dscr_min", scenario_result.min_dscr)
    # 2. Monte Carlo simulation (placeholder logic)
    iterations = 1
    mc_project_irr = float(scenario_result.project_irr)
    mc_project_npv = float(scenario_result.project_npv)
    mc_min_dscr = float(scenario_result.min_dscr)
    monte_carlo = MonteCarloResult(
        iterations=iterations,
        project_irr_mean=mc_project_irr,
        project_irr_std=0.0,
        project_irr_p10=mc_project_irr,
        project_irr_p50=mc_project_irr,
        project_irr_p90=mc_project_irr,
        project_npv_mean=mc_project_npv,
        project_npv_p10=mc_project_npv,
        project_npv_p50=mc_project_npv,
        project_npv_p90=mc_project_npv,
        dscr_min_p10=mc_min_dscr,
        dscr_min_p50=mc_min_dscr,
        failed_iterations=0,
        raw_results=None,
        scenario_name=scenario_name,
    )
    # 3. Tail risk snapshot for specified metric
    metric_value = 0.0
    breach_prob = 0.0
    if metric == "project_irr":
        metric_value = mc_project_irr
        breach_prob = 100.0 if mc_project_irr < 0.0 else 0.0
    elif metric == "project_npv":
        metric_value = mc_project_npv
        breach_prob = 100.0 if mc_project_npv < 0.0 else 0.0
    elif metric == "min_dscr":
        metric_value = mc_min_dscr
        threshold = debt_covenants.dscr_threshold if debt_covenants is not None else 1.0
        breach_prob = 100.0 if mc_min_dscr < threshold else 0.0
    tail_snapshot = TailRiskSnapshot(
        metric=metric,
        confidence=confidence,
        var=float(metric_value),
        cvar=float(metric_value),
        p10=float(metric_value),
        p50=float(metric_value),
        p90=float(metric_value),
        breach_probability=float(breach_prob),
    )
    # 4. Assemble CasperResult
    casper = CasperResult(
        scenario=scenario_result,
        baseline_kpis={k: float(v) for k, v in kpis.items()},
        sensitivities=sensitivity_suite,
        monte_carlo=monte_carlo,
        generation=None,
        multi_tech_generation_breakdown=None,
    )
    casper.metadata["tail_risk"] = {metric: tail_snapshot}
    return casper
