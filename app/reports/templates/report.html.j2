<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <title>{{ ctx.meta.title }} — {{ ctx.site_name }}</title>
  <style>
    @page {
      size: A4;
      margin: 22mm 18mm 20mm 18mm;
      @bottom-center {
        content: "{{ ctx.meta.confidentiality }}";
        font-size: 8pt;
        color: #888;
      }
      @bottom-right {
        content: "Page " counter(page) " of " counter(pages);
        font-size: 8pt;
        color: #888;
      }
    }
    body {
      font-family: "Helvetica Neue", Arial, sans-serif;
      color: #1c2733;
      font-size: 10.5pt;
      line-height: 1.45;
    }
    .page { page-break-after: always; }
    .page:last-child { page-break-after: auto; }
    h1 { font-size: 22pt; margin: 0 0 4pt 0; color: #0b3d62; }
    h2 {
      font-size: 14pt;
      color: #0b3d62;
      border-bottom: 2px solid #0b3d62;
      padding-bottom: 3pt;
      margin-top: 0;
    }
    h3 { font-size: 11pt; color: #34556b; margin-bottom: 4pt; }
    .cover { margin-top: 60mm; }
    .cover .subtitle { font-size: 13pt; color: #34556b; margin-top: 2pt; }
    .cover .site { font-size: 16pt; margin-top: 28mm; font-weight: 600; }
    .cover .org { margin-top: 6pt; color: #34556b; }
    .cover .meta { margin-top: 22mm; font-size: 9pt; color: #666; }
    .confidential {
      display: inline-block;
      margin-top: 10pt;
      padding: 3pt 8pt;
      border: 1px solid #b23b3b;
      color: #b23b3b;
      font-size: 9pt;
      letter-spacing: 0.5pt;
      text-transform: uppercase;
    }
    table { width: 100%; border-collapse: collapse; margin-top: 6pt; }
    th, td { text-align: left; padding: 5pt 8pt; border-bottom: 1px solid #dfe6ec; }
    th { background: #eef3f7; color: #0b3d62; font-size: 9.5pt; }
    td.num { text-align: right; font-variant-numeric: tabular-nums; }
    .headline {
      font-size: 13pt;
      font-weight: 600;
      padding: 10pt 12pt;
      border-left: 4px solid #0b3d62;
      background: #f3f7fa;
      margin: 8pt 0 12pt 0;
    }
    .badge {
      display: inline-block;
      padding: 2pt 8pt;
      border-radius: 3pt;
      font-size: 9pt;
      font-weight: 600;
    }
    .pass { background: #e3f4e8; color: #1d7a3e; }
    .fail { background: #fdeaea; color: #b23b3b; }
    .sev-low { background: #e3f4e8; color: #1d7a3e; }
    .sev-medium { background: #fff4e0; color: #9a6700; }
    .sev-high { background: #fdeaea; color: #b23b3b; }
    .rag-green { background: #e3f4e8; color: #1d7a3e; }
    .rag-amber { background: #fff4e0; color: #9a6700; }
    .rag-red { background: #fdeaea; color: #b23b3b; }
    /* TCFD climate-risk tags (EP4-aligned CCRA) — physical vs transition. */
    .tcfd-physical { background: #e8eef7; color: #2a4d80; }
    .tcfd-transition { background: #f0e8f7; color: #5e3b80; }
    ul.notes { margin: 6pt 0; padding-left: 18pt; }
    ul.notes li { margin-bottom: 3pt; }
    .disclaimer { font-size: 9pt; color: #555; }
    .muted { color: #888; }
  </style>
</head>
<body>

  {# 1. Cover #}
  <section class="page cover">
    <h1>{{ ctx.meta.title }}</h1>
    <div class="subtitle">{{ ctx.meta.subtitle }}</div>
    <div class="site">{{ ctx.site_name }}</div>
    <div class="org">{{ ctx.meta.organization }}</div>
    <div class="meta">
      Scenario variant: {{ ctx.scenario_variant }}<br />
      Generated: {{ ctx.generated_at }}<br />
      Report version: {{ ctx.meta.version }}
    </div>
    <div class="confidential">{{ ctx.meta.confidentiality }}</div>
  </section>

  {# 2. Important notice #}
  <section class="page">
    <h2>Important Notice</h2>
    <p class="disclaimer">{{ ctx.meta.disclaimer }}</p>
  </section>

  {# 3. Executive summary #}
  <section class="page">
    <h2>Executive Summary</h2>
    <div class="headline">{{ ctx.verdict.headline }}</div>
    <p>Pipeline status: <strong>{{ ctx.status }}</strong></p>
    {% if ctx.finance %}
    <table>
      <thead><tr><th>Headline metric</th><th style="text-align:right;">Value</th></tr></thead>
      <tbody>
        <tr><td>Project IRR</td><td class="num">{{ fmt_ratio_pct(ctx.finance.kpis.project_irr) }}</td></tr>
        <tr><td>Equity IRR</td><td class="num">{{ fmt_ratio_pct(ctx.finance.kpis.equity_irr) }}</td></tr>
        <tr><td>Project NPV</td><td class="num">{{ fmt_usd(ctx.finance.kpis.project_npv_usd) }}</td></tr>
        <tr><td>Minimum DSCR</td><td class="num">{{ fmt_x(ctx.finance.kpis.min_dscr) }}</td></tr>
        <tr><td>LLCR / PLCR</td><td class="num">{{ fmt_x(ctx.finance.kpis.llcr) }} / {{ fmt_x(ctx.finance.kpis.plcr) }}</td></tr>
        <tr><td>Equity multiple</td><td class="num">{{ fmt_x(ctx.finance.kpis.equity_multiple) }}</td></tr>
      </tbody>
    </table>
    {% endif %}
    <ul class="notes">
      {% for note in ctx.verdict.notes %}
      <li>{{ note }}</li>
      {% endfor %}
    </ul>
  </section>

  {# 4. Key financial indicators #}
  <section class="page">
    <h2>Key Financial Indicators</h2>
    {% if ctx.kpi_rows %}
    <table>
      <thead><tr><th>Indicator</th><th style="text-align:right;">Value</th></tr></thead>
      <tbody>
        {% for row in ctx.kpi_rows %}
        <tr><td>{{ row.label }}</td><td class="num">{{ row.display }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="muted">No KPIs were available for this run.</p>
    {% endif %}
  </section>

  {# 4b. Energy production (P50/P90) — RPT-1 #}
  {% if ctx.finance %}
  <section class="page">
    <h2>Energy Production (P50 / P90)</h2>
    <table>
      <thead><tr><th>Production basis</th><th style="text-align:right;">Net AEP</th></tr></thead>
      <tbody>
        <tr><td>P50 (central estimate)</td><td class="num">{{ fmt_gwh(ctx.finance.aep.net_p50_gwh) }}</td></tr>
        <tr><td>P75</td><td class="num">{{ fmt_gwh(ctx.finance.aep.net_p75_gwh) }}</td></tr>
        <tr><td>P90 (1-year downside)</td><td class="num">{{ fmt_gwh(ctx.finance.aep.net_p90_gwh) }}</td></tr>
        <tr><td>Gross AEP</td><td class="num">{{ fmt_gwh(ctx.finance.aep.gross_gwh) }}</td></tr>
        <tr><td>Net capacity factor</td><td class="num">{{ fmt_ratio_pct(ctx.finance.aep.capacity_factor) }}</td></tr>
      </tbody>
    </table>
    {% if ctx.finance.aep.source_id %}
    <p class="muted">Resource basis: {{ ctx.finance.aep.source_id }}. Debt is sized on the
      downside production case where the dual-DSCR sizer so binds.</p>
    {% endif %}
  </section>
  {% endif %}

  {# 4c. Sources & Uses of funds — RPT-1 #}
  {% if ctx.finance %}
  <section class="page">
    <h2>Sources &amp; Uses of Funds</h2>
    <h3>Uses</h3>
    <table>
      <tbody>
        <tr><td>CAPEX (EPC + development)</td><td class="num">{{ fmt_usd(ctx.finance.funding.capex_usd) }}</td></tr>
        <tr><td>Interest during construction (IDC)</td><td class="num">{{ fmt_usd(ctx.finance.funding.idc_usd) }}</td></tr>
        {% if ctx.finance.funding.initial_dsra_usd %}
        <tr><td>DSRA funded at close</td><td class="num">{{ fmt_usd(ctx.finance.funding.initial_dsra_usd) }}</td></tr>
        {% endif %}
        <tr><td><strong>Total uses</strong></td><td class="num"><strong>{{ fmt_usd(ctx.finance.funding.uses_total_usd) }}</strong></td></tr>
      </tbody>
    </table>
    <h3>Sources</h3>
    <table>
      <tbody>
        <tr><td>Senior debt</td><td class="num">{{ fmt_usd(ctx.finance.funding.senior_debt_usd) }}</td></tr>
        <tr><td>Sponsor equity</td><td class="num">{{ fmt_usd(ctx.finance.funding.equity_usd) }}</td></tr>
        <tr><td><strong>Total sources</strong></td><td class="num"><strong>{{ fmt_usd(ctx.finance.funding.sources_total_usd) }}</strong></td></tr>
      </tbody>
    </table>
    <p>Sources &amp; uses balance:
      {% if ctx.finance.funding.balanced %}<span class="badge pass">Balanced</span>
      {% elif ctx.finance.funding.balanced is none %}<span class="muted">not reported</span>
      {% else %}<span class="badge fail">Imbalanced</span>{% endif %}
    </p>
    <h3>CAPEX benchmark</h3>
    <p>{{ fmt_usd(ctx.finance.cost.capex_total_usd) }} total{% if ctx.finance.cost.capex_per_kw_usd %} &mdash;
      {{ fmt_usd(ctx.finance.cost.capex_per_kw_usd) }}/kW{% if ctx.finance.cost.irena_benchmark_per_kw %} vs IRENA {{ fmt_usd(ctx.finance.cost.irena_benchmark_per_kw) }}/kW{% endif %}{% endif %}
      {% if ctx.finance.cost.within_band is not none %}
      {% if ctx.finance.cost.within_band %}<span class="badge pass">Within band</span>{% else %}<span class="badge fail">Outside band</span>{% endif %}
      {% endif %}
    </p>
    {% if ctx.finance.cost.note %}<p class="muted">{{ ctx.finance.cost.note }}</p>{% endif %}
  </section>
  {% endif %}

  {# 4d. Debt structure & DSCR profile — RPT-1 #}
  {% if ctx.finance %}
  <section class="page">
    <h2>Debt Structure &amp; DSCR Profile</h2>
    <table>
      <tbody>
        <tr><td>Senior debt sized</td><td class="num">{{ fmt_usd(ctx.finance.debt.debt_total_usd) }}</td></tr>
        <tr><td>Gearing</td><td class="num">{{ fmt_ratio_pct(ctx.finance.debt.gearing) }}</td></tr>
        <tr><td>Tenor (operating years)</td><td class="num">{{ ctx.finance.debt.tenor_years if ctx.finance.debt.tenor_years is not none else "—" }}</td></tr>
        <tr><td>Average debt rate</td><td class="num">{{ fmt_pct(ctx.finance.debt.avg_debt_rate_pct) }}</td></tr>
        <tr><td>Minimum / average DSCR</td><td class="num">{{ fmt_x(ctx.finance.debt.min_dscr) }} / {{ fmt_x(ctx.finance.debt.avg_dscr) }}</td></tr>
        <tr><td>Balloon at maturity</td><td class="num">{{ fmt_ratio_pct(ctx.finance.debt.balloon_pct) }} ({{ fmt_usd(ctx.finance.debt.balloon_remaining_usd) }})</td></tr>
        {% if ctx.finance.debt.binding_constraint %}
        <tr><td>Binding sizing constraint</td><td class="num">{{ ctx.finance.debt.binding_constraint }}{% if ctx.finance.debt.binding_production_case %} ({{ ctx.finance.debt.binding_production_case }}){% endif %}</td></tr>
        {% endif %}
      </tbody>
    </table>
    {% if ctx.finance.debt.schedule %}
    <h3>Annual DSCR profile</h3>
    <table>
      <thead><tr><th>Year</th><th style="text-align:right;">DSCR</th><th style="text-align:right;">Debt outstanding</th><th style="text-align:right;">Debt service</th></tr></thead>
      <tbody>
        {% for r in ctx.finance.debt.schedule %}
        <tr>
          <td>{{ r.year }}</td>
          <td class="num">{{ fmt_x(r.dscr) }}</td>
          <td class="num">{{ fmt_usd(r.debt_outstanding_usd) }}</td>
          <td class="num">{{ fmt_usd(r.debt_service_usd) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </section>
  {% endif %}

  {# 4e. Sensitivity tornado (one-at-a-time) — RPT-1 #}
  {% if ctx.tornado and ctx.tornado.rows %}
  <section class="page">
    <h2>Sensitivity Tornado &mdash; Project IRR</h2>
    <p class="muted">One-at-a-time sensitivity of the project IRR to each driver
      (base {{ fmt_ratio_pct(ctx.tornado.rows[0].base) }}); drivers ordered by swing
      magnitude, widest first.</p>
    <table>
      <thead>
        <tr>
          <th>Driver</th>
          <th style="text-align:right;">Downside IRR</th>
          <th style="text-align:right;">Upside IRR</th>
          <th style="text-align:right;">Swing</th>
        </tr>
      </thead>
      <tbody>
        {% for r in ctx.tornado.rows %}
        <tr>
          <td>{{ r.label }}</td>
          <td class="num">{{ fmt_ratio_pct(r.low_case) }}</td>
          <td class="num">{{ fmt_ratio_pct(r.high_case) }}</td>
          <td class="num">{{ fmt_ratio_pct(r.impact_abs) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {# 4f. Global sensitivity (Morris screening) — MC-1 #}
  {% if ctx.global_sa and ctx.global_sa.drivers %}
  <section class="page">
    <h2>Global Sensitivity &mdash; Morris Screening</h2>
    <p class="muted">Variance-aware global importance of each driver for the project
      IRR (Morris elementary effects over {{ ctx.global_sa.n_runs }} model evaluations);
      the global complement to the one-at-a-time tornado above. Drivers are ranked by
      &mu;* (overall influence, interactions included); a high &sigma; flags a
      non-linear / interactive effect.</p>
    <table>
      <thead>
        <tr>
          <th>Driver</th>
          <th style="text-align:right;">&mu;* (importance)</th>
          <th style="text-align:right;">&sigma; (non-linearity)</th>
        </tr>
      </thead>
      <tbody>
        {% for d in ctx.global_sa.drivers %}
        <tr>
          <td>{{ d.name }}</td>
          <td class="num">{{ fmt_ratio_pct(d.mu_star) }}</td>
          <td class="num">{{ fmt_ratio_pct(d.sigma) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {# 5. Covenant assessment #}
  <section class="page">
    <h2>Covenant Assessment</h2>
    <table>
      <thead><tr><th>Test</th><th>Threshold</th><th>Result</th></tr></thead>
      <tbody>
        <tr>
          <td>Project IRR vs cost of capital</td>
          <td>&ge; WACC (project hurdle)</td>
          <td>
            {% if ctx.verdict.project_viable %}<span class="badge pass">Pass</span>
            {% else %}<span class="badge fail">Below hurdle</span>{% endif %}
          </td>
        </tr>
        <tr>
          <td>Equity returns to sponsors</td>
          <td>Positive NPV / IRR</td>
          <td>
            {% if ctx.verdict.equity_positive %}<span class="badge pass">Positive</span>
            {% else %}<span class="badge fail">Negative</span>{% endif %}
          </td>
        </tr>
        <tr>
          <td>Minimum DSCR</td>
          <td>&ge; {{ "%.2f"|format(ctx.covenants.min_dscr_floor) }}x floor</td>
          <td>
            {% if ctx.verdict.dscr_covenant_met %}<span class="badge pass">Met</span>
            {% else %}<span class="badge fail">Breach</span>{% endif %}
          </td>
        </tr>
        <tr>
          <td>Balloon / bullet share</td>
          <td>&le; {{ "%.0f"|format(ctx.covenants.max_balloon_pct * 100) }}% ceiling</td>
          <td>
            {% if ctx.verdict.balloon_within_limit %}<span class="badge pass">Within</span>
            {% else %}<span class="badge fail">Exceeds</span>{% endif %}
          </td>
        </tr>
      </tbody>
    </table>
  </section>

  {# 6. Risk register #}
  <section class="page">
    <h2>Risk Register</h2>
    {% if ctx.risk_register %}
    <table>
      <thead>
        <tr><th>Category</th><th>Risk</th><th>Mitigation</th><th>Residual</th></tr>
      </thead>
      <tbody>
        {% for r in ctx.risk_register %}
        <tr>
          <td>{{ r.category }}{% if r.climate_risk_category %}
            <span class="badge tcfd-{{ r.climate_risk_category }}">TCFD: {{ r.climate_risk_category|capitalize }}</span>{% endif %}</td>
          <td>{{ r.risk }}</td>
          <td>{{ r.mitigation }}</td>
          <td><span class="badge sev-{{ r.severity }}">{{ r.severity|capitalize }}</span></td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="muted">No project risks were registered for this scenario.</p>
    {% endif %}
  </section>

  {# 7. Development readiness / E&S status #}
  <section class="page">
    <h2>Development Readiness &amp; E&amp;S Status</h2>
    {% if ctx.readiness %}
    <p>Overall readiness:
      <span class="badge rag-{{ ctx.overall_readiness }}">{{ ctx.overall_readiness|capitalize }}</span>
      <span class="muted">(worst declared workstream status)</span>
    </p>
    <table>
      <thead><tr><th>Workstream</th><th>Status</th><th>Note</th></tr></thead>
      <tbody>
        {% for r in ctx.readiness %}
        <tr>
          <td>{{ r.workstream }}</td>
          <td><span class="badge rag-{{ r.status }}">{{ r.status|capitalize }}</span></td>
          <td>{{ r.note }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="muted">No development-readiness register was supplied for this scenario.</p>
    {% endif %}
  </section>

  {# 8. Assumptions register #}
  <section class="page">
    <h2>Assumptions Register</h2>
    {% if ctx.assumptions %}
    <table>
      <thead>
        <tr>
          <th>Assumption</th>
          <th style="text-align:right;">Value</th>
          <th>Source</th>
          <th>As of</th>
          <th>Impact</th>
        </tr>
      </thead>
      <tbody>
        {% for row in ctx.assumptions %}
        <tr>
          <td>{{ row.label }}</td>
          <td class="num">{{ row.display }}</td>
          <td>{{ row.source or "—" }}</td>
          <td>{{ row.as_of or "—" }}</td>
          <td>{{ row.impact or "—" }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="muted">Source and as-of are shown where the scenario's evidence register declares
      provenance for the assumption; impact is the KPI each assumption most directly moves.</p>
    {% else %}
    <p class="muted">Assumptions were inherited from the base scenario variant
      ({{ ctx.scenario_variant }}); no wizard overrides were supplied.</p>
    {% endif %}
  </section>

  {# 8a-bis. Multi-technology breakdown (hybrid plants) — ARCH-4 / #476 #}
  {% if ctx.multi_tech %}
  <section class="page">
    <h2>Multi-Technology Breakdown</h2>
    <p>Per-technology production and economics for the combined plant
      (total net AEP {{ fmt_gwh(ctx.multi_tech.total_aep_gwh) }}). CFADS is apportioned by
      operating margin (revenue minus opex); CAPEX/OPEX and cost-of-capital are the
      reporting per-technology work-breakdown. These are an additive attribution of one
      combined-plant run and do not change the committed economics.</p>
    <table>
      <thead>
        <tr>
          <th>Technology</th><th>Net AEP</th><th>AEP %</th><th>CFADS %</th>
          <th>CAPEX</th><th>CAPEX %</th><th>OPEX/yr</th><th>Cost of equity</th>
        </tr>
      </thead>
      <tbody>
        {% for r in ctx.multi_tech.rows %}
        <tr>
          <td>{{ r.technology }}</td>
          <td class="num">{{ fmt_gwh(r.aep_gwh) }}</td>
          <td class="num">{{ fmt_pct(r.share_of_aep_pct) }}</td>
          <td class="num">{{ fmt_pct(r.share_of_cfads_pct) }}</td>
          <td class="num">{{ fmt_usd(r.capex_usd) }}</td>
          <td class="num">{{ fmt_pct(r.share_of_capex_pct) }}</td>
          <td class="num">{{ fmt_usd(r.opex_usd_per_year) }}</td>
          <td class="num">{% if r.cost_of_equity is not none %}{{ fmt_ratio_pct(r.cost_of_equity) }} ({{ r.wacc_basis }}){% else %}blended{% endif %}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% if ctx.multi_tech.financed_capex_usd is not none %}
    <p class="muted">Financed CAPEX {{ fmt_usd(ctx.multi_tech.financed_capex_usd) }};
      attributed {{ fmt_usd(ctx.multi_tech.allocated_capex_usd) }};
      shared / balance-of-plant residual {{ fmt_usd(ctx.multi_tech.capex_residual_usd) }}
      ({% if ctx.multi_tech.capex_reconciled %}reconciled{% else %}not reconciled{% endif %}).
      {% if ctx.multi_tech.project_wacc_nominal is not none %}Project discount rate /
      blended WACC {{ fmt_ratio_pct(ctx.multi_tech.project_wacc_nominal) }}.{% endif %}</p>
    {% endif %}
    {% if ctx.multi_tech.poi_curtailment_pct is not none %}
    <p class="muted">Shared point-of-interconnection limit
      {{ "%.0f"|format(ctx.multi_tech.poi_limit_mw) }} MW: combined injection is curtailed
      {{ fmt_pct(ctx.multi_tech.poi_curtailment_pct) }} of gross generation
      ({{ fmt_gwh((ctx.multi_tech.poi_curtailed_energy_mwh / 1000.0) if ctx.multi_tech.poi_curtailed_energy_mwh is not none else none) }} lost).</p>
    {% endif %}
  </section>
  {% endif %}

  {# 8a-ter. Three-statement financial statements + tie-outs — #479 #}
  {% if ctx.three_statement %}
  <section class="page">
    <h2>Financial Statements ({{ ctx.three_statement.currency }})</h2>
    <p>Three articulating statements assembled from the engine's annual outputs. Tie-out
      status:
      {% if ctx.three_statement.tie_outs_pass %}<span class="badge pass">All tie-outs pass</span>
      {% else %}<span class="badge fail">Tie-out break</span>{% endif %}
      independent debt-retires-to-residual check: {{ ctx.three_statement.debt_retires_to_residual }};
      balance sheet balances: {{ ctx.three_statement.balance_sheet_balances }};
      cash flow reconciles: {{ ctx.three_statement.cashflow_reconciles }};
      retained-earnings roll-forward: {{ ctx.three_statement.retained_earnings_rolls }};
      max balance residual {{ fmt_usd(ctx.three_statement.max_abs_balance_residual) }}).</p>

    <h3>Income statement</h3>
    <table>
      <thead><tr><th>Year</th><th>Revenue</th><th>EBITDA</th><th>Depr.</th><th>EBIT</th><th>Interest</th><th>Tax</th><th>Net income</th></tr></thead>
      <tbody>
        {% for r in ctx.three_statement.income_statement %}
        <tr><td>{{ r.year }}</td><td class="num">{{ fmt_usd(r.revenue) }}</td><td class="num">{{ fmt_usd(r.ebitda) }}</td><td class="num">{{ fmt_usd(r.depreciation) }}</td><td class="num">{{ fmt_usd(r.ebit) }}</td><td class="num">{{ fmt_usd(r.interest) }}</td><td class="num">{{ fmt_usd(r.tax) }}</td><td class="num">{{ fmt_usd(r.net_income) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <h3>Cash flow statement</h3>
    <table>
      <thead><tr><th>Year</th><th>CFO</th><th>CFI</th><th>Debt principal</th><th>Distributions</th><th>CFF</th><th>Net change</th><th>Cash</th></tr></thead>
      <tbody>
        {% for r in ctx.three_statement.cash_flow %}
        <tr><td>{{ r.year }}</td><td class="num">{{ fmt_usd(r.cfo) }}</td><td class="num">{{ fmt_usd(r.cfi) }}</td><td class="num">{{ fmt_usd(r.debt_principal) }}</td><td class="num">{{ fmt_usd(r.distributions) }}</td><td class="num">{{ fmt_usd(r.cff) }}</td><td class="num">{{ fmt_usd(r.net_change_in_cash) }}</td><td class="num">{{ fmt_usd(r.closing_cash) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <h3>Balance sheet</h3>
    <table>
      <thead><tr><th>Year</th><th>PP&amp;E</th><th>Cash</th><th>Assets</th><th>Debt</th><th>Equity</th><th>L &amp; E</th><th>Residual</th></tr></thead>
      <tbody>
        {% for r in ctx.three_statement.balance_sheet %}
        <tr><td>{{ r.year }}</td><td class="num">{{ fmt_usd(r.ppe_net) }}</td><td class="num">{{ fmt_usd(r.cash) }}</td><td class="num">{{ fmt_usd(r.total_assets) }}</td><td class="num">{{ fmt_usd(r.debt) }}</td><td class="num">{{ fmt_usd(r.total_equity) }}</td><td class="num">{{ fmt_usd(r.total_liabilities_and_equity) }}</td><td class="num">{{ fmt_usd(r.balance_residual) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </section>
  {% endif %}

  {# 8a-quater. Cash-flow waterfall by payment priority — #481 / RPT-2 #}
  {% if ctx.cashflow_waterfall %}
  <section class="page">
    <h2>Cash-Flow Waterfall by Payment Priority ({{ ctx.cashflow_waterfall.currency }})</h2>
    <p>Operating cash applied in lender priority each year: cash available for debt service
      (CFADS) first meets scheduled senior debt service, then the balloon is retired at maturity,
      and only the residual is available to equity. Every figure is the engine's own published
      cash flow, so CFADS and scheduled debt service are the same numbers used in the headline
      KPIs and the Debt Structure &amp; DSCR Profile section above. The balloon sweep is shown
      separately because it is senior to equity but is NOT part of the scheduled debt service that
      sets the DSCR covenant. The model sweeps 100% of post-senior cash to equity, so cash to
      equity is the distribution — no reserve balance accumulates beyond the DSRA funded at
      financial close. Year N is operating year N (post-COD); the DSCR-profile section indexes from
      financial close, so its construction and bridge periods precede operating year&nbsp;1.</p>
    <table>
      <thead>
        <tr>
          <th>Year</th>
          <th style="text-align:right;">CFADS</th>
          <th style="text-align:right;">Scheduled debt service</th>
          <th style="text-align:right;">Balloon sweep</th>
          <th style="text-align:right;">Cash to equity</th>
        </tr>
      </thead>
      <tbody>
        {% for r in ctx.cashflow_waterfall.rows %}
        <tr>
          <td>{{ r.year }}</td>
          <td class="num">{{ fmt_usd(r.cfads) }}</td>
          <td class="num">{{ fmt_usd(r.scheduled_debt_service) }}</td>
          <td class="num">{{ fmt_usd(r.balloon_sweep) }}</td>
          <td class="num">{{ fmt_usd(r.cash_to_equity) }}</td>
        </tr>
        {% endfor %}
        <tr>
          <td><strong>Total</strong></td>
          <td class="num"><strong>{{ fmt_usd(ctx.cashflow_waterfall.total_cfads) }}</strong></td>
          <td class="num"><strong>{{ fmt_usd(ctx.cashflow_waterfall.total_scheduled_debt_service) }}</strong></td>
          <td class="num"><strong>{{ fmt_usd(ctx.cashflow_waterfall.total_balloon_sweep) }}</strong></td>
          <td class="num"><strong>{{ fmt_usd(ctx.cashflow_waterfall.total_cash_to_equity) }}</strong></td>
        </tr>
      </tbody>
    </table>
  </section>
  {% endif %}

  {# 8b. Assumption evidence register — #435 / RPT-1 #}
  {% if ctx.evidence %}
  <section class="page">
    <h2>Assumption Evidence Register</h2>
    <p>Material assumptions with declared evidence:
      <strong>{{ ctx.evidence.covered }} of {{ ctx.evidence.total }}</strong>.</p>
    {% if ctx.evidence.rows %}
    <table>
      <thead>
        <tr><th>Assumption</th><th>Source</th><th>As of</th><th>Tier</th><th>Note</th></tr>
      </thead>
      <tbody>
        {% for r in ctx.evidence.rows %}
        <tr>
          <td>{{ r.assumption }}</td>
          <td>{{ r.source or "—" }}</td>
          <td>{{ r.as_of or "—" }}</td>
          <td>{{ r.tier or "—" }}</td>
          <td>{{ r.note }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="muted">No source evidence was declared for the material assumptions in this
      scenario.</p>
    {% endif %}
    {% if ctx.evidence.missing %}
    <h3>Assumptions without declared evidence</h3>
    <p class="muted">{{ ctx.evidence.missing | join(", ") }}</p>
    {% endif %}
  </section>
  {% endif %}

  {# 9. Audit manifest & methodology #}
  <section class="page">
    <h2>Audit Manifest &amp; Methodology</h2>
    <h3>Run manifest</h3>
    {% if ctx.manifest %}
    <table>
      <tbody>
        {% for key, value in ctx.manifest.items() %}
        {# Manifest values are identifiers/timestamps (run id, version, git SHA, config hash) —
           left-aligned, not numeric (RPT-4). #}
        <tr><td>{{ key }}</td><td>{{ value }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="muted">No structured manifest was emitted for this run.</p>
    {% endif %}
    <h3>Methodology</h3>
    <p class="disclaimer">
      Figures are produced by the DutchBay v14 project-finance engine: an
      ERA5&rarr;Weibull&rarr;AEP wind-resource chain feeding a CFADS waterfall with
      DSCR-sculpted multi-tranche debt, TLCF tax, and IRR/NPV/LLCR/PLCR metrics.
      All values in this report are engine outputs presented unchanged; the cost
      of capital shown is the run's own resolved project discount rate.
    </p>
  </section>

</body>
</html>
