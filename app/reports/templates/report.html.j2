  {# 8c. Bankability evidence-completeness score — #707 #}
  {% if ctx.evidence_score %}
  <section class="page">
    <h2>Bankability Evidence-Completeness Score</h2>
    <p>Overall score:
      <strong>{{ "%.1f"|format(ctx.evidence_score.score) }} / 100</strong>
      &mdash; <em>{{ ctx.evidence_score.band }}</em>.</p>
    <p class="muted">A config-weighted measure of how completely and how strongly the material
      assumptions are evidenced: {{ ctx.evidence_score.covered }} of
      {{ ctx.evidence_score.total }} assumptions carry gradeable (sourced, in-tier) evidence
      ({{ "%.0f"|format(ctx.evidence_score.coverage_pct) }}% coverage){% if ctx.evidence_score.covered %}; mean evidence strength
      over those is {{ "%.2f"|format(ctx.evidence_score.mean_covered_strength) }}{% endif %}. Read-only —
      it derives from the evidence register above and moves no financial figure.</p>
    {% if ctx.evidence_score.rows %}
    <table>
      <thead>
        <tr><th>Assumption</th><th>Tier</th><th style="text-align:right;">Strength</th></tr>
      </thead>
      <tbody>
        {% for r in ctx.evidence_score.rows %}
        <tr>
          <td>{{ r.assumption }}</td>
          <td>{{ r.tier or "—" }}</td>
          <td class="num">{{ "%.2f"|format(r.strength) }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </section>
  {% endif %}

  {# 9. Audit manifest & methodology #}
  <section class="page">
    <h2>Audit Manifest &amp; Methodology</h2>
    <h3>Run manifest</h3>
    {% if ctx.manifest %}
    <table>
      <tbody>
        {% for key, value in ctx.manifest.items() %}
        {# Manifest values are identifiers/timestamps (run id, version, git SHA, config hash) —
           left-aligned, not numeric (RPT-4). #}
        <tr><td>{{ key }}</td><td>{{ value }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
    <p class="muted">No structured manifest was emitted for this run.</p>
    {% endif %}
    <h3>Methodology</h3>
    <p class="disclaimer">
      Figures are produced by the DutchBay v14 project-finance engine: an
      ERA5&rarr;Weibull&rarr;AEP wind-resource chain feeding a CFADS waterfall with
      DSCR-sculpted multi-tranche debt, TLCF tax, and IRR/NPV/LLCR/PLCR metrics.
      All values in this report are engine outputs presented unchanged; the cost
      of capital shown is the run's own resolved project discount rate.
    </p>
    {# Model limitations & assumptions (#734): the one report-wide home for scope caveats,
       so no output is read without them. Render-when-present. #}
    {% if ctx.model_limitations %}
    <h3>Model Limitations &amp; Assumptions</h3>
    <table>
      <thead><tr><th>Area</th><th>Limitation</th></tr></thead>
      <tbody>
        {% for lim in ctx.model_limitations %}
        <tr><td>{{ lim.topic }}</td><td>{{ lim.detail }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    {% endif %}
  </section>

</body>
</html>
