  {# 8a-bis-2. Long-term wind resource & trend (disclose-only) — #178 / #656 #}
  {% if ctx.resource_trend %}
  <section class="page">
    <h2>Long-Term Wind Resource &amp; Trend</h2>
    <p>Reference {{ ctx.resource_trend.reference_period }}. Mann-Kendall trend test:
      tau {{ "%.3f"|format(ctx.resource_trend.mk_tau) }}, p={{ "%.4f"|format(ctx.resource_trend.mk_pvalue) }}
      ({% if ctx.resource_trend.trend_significant %}significant{% else %}not significant{% endif %} at 5%);
      Sen slope {{ "%+.3f"|format(ctx.resource_trend.sen_slope_per_decade) }} m/s/decade;
      OLS R&sup2; {{ "%.4f"|format(ctx.resource_trend.ols_r2) }}.
      <strong>Classification: {{ ctx.resource_trend.classification }}.</strong>
      {{ ctx.resource_trend.classification_note }}</p>
    <table>
      <thead>
        <tr><th>Metric</th><th>Value</th></tr>
      </thead>
      <tbody>
        {% for r in ctx.resource_trend.summary_rows %}
        <tr><td>{{ r.metric }}</td><td>{{ r.value }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    <p class="muted">Recommended forward P50 basis: <strong>{{ ctx.resource_trend.recommended_basis }}</strong>
      {% if ctx.resource_trend.recommended_p50_gwh is not none %}= {{ fmt_gwh(ctx.resource_trend.recommended_p50_gwh) }}{% endif %}
      {%- if ctx.resource_trend.recommended_p50_cf is not none %} (CF {{ fmt_ratio_pct(ctx.resource_trend.recommended_p50_cf) }}){% endif %}
      {%- if ctx.resource_trend.downside_p50_gwh is not none %} — downside {{ fmt_gwh(ctx.resource_trend.downside_p50_gwh) }}{% endif %}
      {%- if ctx.resource_trend.upside_p50_gwh is not none %}, upside {{ fmt_gwh(ctx.resource_trend.upside_p50_gwh) }}{% endif %}.
      This is an IEC 61400-15-1 / MEASNET long-term-reference disclosure of the forward resource
      basis; it does <strong>not</strong> change the committed/frozen scenario P50 used in the
      economics above. The trend is computed on ERA5 reanalysis annual means: a statistically
      significant slope may reflect reanalysis inhomogeneity (evolving assimilated observation
      streams across decades) rather than a real climatological signal, so it is presented as a
      long-term-reference disclosure, not an operational forecast.</p>
  </section>
  {% endif %}

  {# 8a-ter. Three-statement financial statements + tie-outs — #479 #}
  {% if ctx.three_statement %}
  <section class="page">
    <h2>Financial Statements ({{ ctx.three_statement.currency }})</h2>
    <p>Three articulating statements assembled from the engine's annual outputs. Tie-out
      status:
      {% if ctx.three_statement.tie_outs_pass %}<span class="badge pass">All tie-outs pass</span>
      {% else %}<span class="badge fail">Tie-out break</span>{% endif %}
      independent debt-retires-to-residual check: {{ ctx.three_statement.debt_retires_to_residual }};
      balance sheet balances: {{ ctx.three_statement.balance_sheet_balances }};
      cash flow reconciles: {{ ctx.three_statement.cashflow_reconciles }};
      retained-earnings roll-forward: {{ ctx.three_statement.retained_earnings_rolls }};
      max balance residual {{ fmt_usd(ctx.three_statement.max_abs_balance_residual) }}).</p>

    <h3>Income statement</h3>
    <table>
      <thead><tr><th>Year</th><th>Revenue</th><th>EBITDA</th><th>Depr.</th><th>EBIT</th><th>Interest</th><th>Tax</th><th>Net income</th></tr></thead>
      <tbody>
        {% for r in ctx.three_statement.income_statement %}
        <tr><td>{{ r.year }}</td><td class="num">{{ fmt_usd(r.revenue) }}</td><td class="num">{{ fmt_usd(r.ebitda) }}</td><td class="num">{{ fmt_usd(r.depreciation) }}</td><td class="num">{{ fmt_usd(r.ebit) }}</td><td class="num">{{ fmt_usd(r.interest) }}</td><td class="num">{{ fmt_usd(r.tax) }}</td><td class="num">{{ fmt_usd(r.net_income) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <h3>Cash flow statement</h3>
    <table>
      <thead><tr><th>Year</th><th>CFO</th><th>CFI</th><th>Debt principal</th><th>Distributions</th><th>CFF</th><th>Net change</th><th>Cash</th></tr></thead>
      <tbody>
        {% for r in ctx.three_statement.cash_flow %}
        <tr><td>{{ r.year }}</td><td class="num">{{ fmt_usd(r.cfo) }}</td><td class="num">{{ fmt_usd(r.cfi) }}</td><td class="num">{{ fmt_usd(r.debt_principal) }}</td><td class="num">{{ fmt_usd(r.distributions) }}</td><td class="num">{{ fmt_usd(r.cff) }}</td><td class="num">{{ fmt_usd(r.net_change_in_cash) }}</td><td class="num">{{ fmt_usd(r.closing_cash) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>

    <h3>Balance sheet</h3>
    <table>
      <thead><tr><th>Year</th><th>PP&amp;E</th><th>Cash</th><th>Assets</th><th>Debt</th><th>Equity</th><th>L &amp; E</th><th>Residual</th></tr></thead>
      <tbody>
        {% for r in ctx.three_statement.balance_sheet %}
        <tr><td>{{ r.year }}</td><td class="num">{{ fmt_usd(r.ppe_net) }}</td><td class="num">{{ fmt_usd(r.cash) }}</td><td class="num">{{ fmt_usd(r.total_assets) }}</td><td class="num">{{ fmt_usd(r.debt) }}</td><td class="num">{{ fmt_usd(r.total_equity) }}</td><td class="num">{{ fmt_usd(r.total_liabilities_and_equity) }}</td><td class="num">{{ fmt_usd(r.balance_residual) }}</td></tr>
        {% endfor %}
      </tbody>
    </table>
    {# #811: the three statements now book PP&E / paid-in equity on the SAME
       levy-inclusive financed-capex basis the debt sizing, NPV, equity distribution,
       and Sources & Uses use (analytics.three_statement._resolve_capex_usd delegates
       to the single finance.debt_v14._extract_capex_usd resolver when import levies /
       a bottom-up breakdown are declared), so paid-in equity ties out to the Sources &
       Uses equity natively. The #738 pre-levy reconciliation footnote is therefore
       removed — the statements reconcile in the numbers, not in prose. #}
  </section>
  {% endif %}

  {# 8a-quater. Cash-flow waterfall by payment priority — #481 / RPT-2 #}
  {% if ctx.cashflow_waterfall %}
  <section class="page">
    <h2>Cash-Flow Waterfall by Payment Priority ({{ ctx.cashflow_waterfall.currency }})</h2>
    <p>Operating cash applied in lender priority each year: cash available for debt service
      (CFADS) first meets scheduled senior debt service, then the balloon is retired at maturity,
      and only the residual is available to equity. Every figure is the engine's own published
      cash flow, so CFADS and scheduled debt service are the same numbers used in the headline
      KPIs and the Debt Structure &amp; DSCR Profile section above. The balloon sweep is shown
      separately because it is senior to equity but is NOT part of the scheduled debt service that
      sets the DSCR covenant. The model sweeps 100% of post-senior cash to equity, so cash to
      equity is the distribution — no reserve balance accumulates beyond the DSRA funded at
      financial close. Year N is operating year N (post-COD); the DSCR-profile section indexes from
      financial close, so its construction and bridge periods precede operating year&nbsp;1.</p>
    <table>
      <thead>
        <tr>
          <th>Year</th>
          <th style="text-align:right;">CFADS</th>
          <th style="text-align:right;">Scheduled debt service</th>
          <th style="text-align:right;">Balloon sweep</th>
          <th style="text-align:right;">Cash to equity</th>
        </tr>
      </thead>
      <tbody>
        {% for r in ctx.cashflow_waterfall.rows %}
        <tr>
          <td>{{ r.year }}</td>
          <td class="num">{{ fmt_usd(r.cfads) }}</td>
          <td class="num">{{ fmt_usd(r.scheduled_debt_service) }}</td>
          <td class="num">{{ fmt_usd(r.balloon_sweep) }}</td>
          <td class="num">{{ fmt_usd(r.cash_to_equity) }}</td>
        </tr>
        {% endfor %}
        <tr>
          <td><strong>Total</strong></td>
          <td class="num"><strong>{{ fmt_usd(ctx.cashflow_waterfall.total_cfads) }}</strong></td>
          <td class="num"><strong>{{ fmt_usd(ctx.cashflow_waterfall.total_scheduled_debt_service) }}</strong></td>
          <td class="num"><strong>{{ fmt_usd(ctx.cashflow_waterfall.total_balloon_sweep) }}</strong></td>
          <td class="num"><strong>{{ fmt_usd(ctx.cashflow_waterfall.total_cash_to_equity) }}</strong></td>
        </tr>
      </tbody>
    </table>
  </section>
  {% endif %}

  {# 8a2. Project → equity IRR bridge — #621 #}
  {% if ctx.irr_bridge %}
  <section class="page">
    <h2>Project &rarr; Equity IRR Bridge</h2>
    <p>How leverage converts the unlevered <strong>project IRR</strong> into the levered
      <strong>equity IRR</strong>. The two endpoints are the report's headline returns — this
      bridge only explains the gap between them, it does not recompute them. Each leg is a single
      substitution step: leverage (the same operating cash on a smaller equity base) lifts the
      return; the cost of debt (interest paid to lenders) drags it down; the interest tax shield
      (interest is tax-deductible) restores part of that drag. The <strong>residual</strong> is
      shown as its own line — IRR is not additive, and the residual carries that interaction term
      together with principal-repayment timing, covenant lockup, the debt-service reserve and
      withholding tax, which the three named legs do not capture in isolation. Legs plus residual
      reconcile exactly to the total uplift.</p>
    <table>
      <thead>
        <tr>
          <th>Step</th>
          <th style="text-align:right;">Contribution</th>
          <th style="text-align:right;">Cumulative IRR</th>
          <th>Note</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td><strong>Project IRR (unlevered)</strong></td>
          <td class="num">&mdash;</td>
          <td class="num"><strong>{{ fmt_ratio_pct(ctx.irr_bridge.project_irr) }}</strong></td>
          <td>Base: return on total project cost.</td>
        </tr>
        {% for leg in ctx.irr_bridge.legs %}
        <tr>
          <td>{{ leg.name|replace("_", " ")|capitalize }}</td>
          <td class="num">{{ fmt_pp(leg.contribution) }}</td>
          <td class="num">{{ fmt_ratio_pct(leg.irr_after) }}</td>
          <td>{{ leg.detail }}</td>
        </tr>
        {% endfor %}
        <tr>
          <td>{{ ctx.irr_bridge.residual_label|replace("_", " ")|capitalize }} (residual)</td>
          <td class="num">{{ fmt_pp(ctx.irr_bridge.residual) }}</td>
          <td class="num">&mdash;</td>
          <td>Principal-repayment timing, covenant lockup, DSRA, WHT and the IRR interaction term.</td>
        </tr>
        <tr>
          <td><strong>Equity IRR (levered)</strong></td>
          <td class="num"><strong>{{ fmt_pp(ctx.irr_bridge.total_uplift) }}</strong></td>
          <td class="num"><strong>{{ fmt_ratio_pct(ctx.irr_bridge.equity_irr) }}</strong></td>
          <td>Total uplift over the project IRR.</td>
        </tr>
      </tbody>
    </table>
  </section>
  {% endif %}

  {# 8b. Assumption evidence register — #435 / RPT-1 #}
  {% if ctx.evidence %}
  <section class="page">
    <h2>Assumption Evidence Register</h2>
    <p>Material assumptions with declared evidence:
      <strong>{{ ctx.evidence.covered }} of {{ ctx.evidence.total }}</strong>.</p>
