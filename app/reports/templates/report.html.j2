          <td>{{ r.assumption }}</td>
          <td>{{ r.source or "—" }}</td>
          <td>{{ r.as_of or "—" }}</td>
          <td>{{ r.tier or "—" }}</td>
          <td>{{ r.note }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
    {% else %}
