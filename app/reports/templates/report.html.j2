      <strong>{{ ctx.cp_checklist.n_satisfied }} satisfied</strong>,
      {{ ctx.cp_checklist.n_waived }} waived,
      <strong>{{ ctx.cp_checklist.n_outstanding }} outstanding</strong>.
      {% if not ctx.cp_checklist.all_satisfied %}
      <span class="badge fail">Outstanding conditions gate first drawdown</span>
      {% elif ctx.cp_checklist.is_clean %}
      <span class="badge pass">No outstanding conditions</span>
      {% else %}
      <span class="badge sev-medium">Checklist has unresolved entries — review below</span>
      {% endif %}
    </p>
    <table>
      <thead><tr><th>Condition</th><th>Workstream</th><th>Status</th><th>Note</th></tr></thead>
      <tbody>
        {% for r in ctx.cp_checklist.rows %}
        <tr>
          <td>{{ r.name }}</td>
          <td>{{ r.workstream }}</td>
          <td>
            {% if r.status == "satisfied" %}<span class="badge pass">Satisfied</span>
            {% elif r.status == "waived" %}<span class="badge sev-medium">Waived</span>
            {% else %}<span class="badge fail">Pending</span>{% endif %}
          </td>
          <td>{{ r.waived_reason or r.note }}</td>
