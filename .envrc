# shellcheck shell=bash
# direnv entry point for this checkout.
#
# Selection is NOT decided here. scripts/development_environment.sh is the single
# source of truth (config/development_environment.json -> DUTCHBAY_VENV, else the
# checkout-local portable fallback), so entering the directory can never disagree
# with ./check_venv.sh about which environment is governed.
#
# This file also never provisions. The sourced activation entrypoint builds the
# resolved environment when it is missing, which with DUTCHBAY_VENV unset would
# create a checkout-local .venv as a side effect of a `cd` -- the per-task
# replacement environment THREAD-01 and ENV-01 forbid. Entering a directory stays
# read-only; run `make setup` deliberately instead.
#
# GWTF: ENV-01, THREAD-01, ARCH-01 (config-first), CESSPIT.

# shellcheck source=scripts/development_environment.sh
. scripts/development_environment.sh

# direnv owns the shell prompt and refuses an exported PS1; keep the activator quiet.
export VIRTUAL_ENV_DISABLE_PROMPT=1

if ! _dutchbay_python=$(dutchbay_find_python312); then
  echo "direnv: Python 3.12 not found; DutchBay environment not activated" >&2
elif ! _dutchbay_venv=$(dutchbay_resolve_venv "$PWD" "$_dutchbay_python"); then
  echo "direnv: could not resolve DUTCHBAY_VENV; environment not activated" >&2
elif [ ! -x "$_dutchbay_venv/bin/python" ]; then
  echo "direnv: $_dutchbay_venv is absent; run 'make setup' or set DUTCHBAY_VENV" >&2
elif ! dutchbay_validate_venv "$PWD" "$_dutchbay_venv" >/dev/null; then
  echo "direnv: $_dutchbay_venv failed the governed health contract; not activated" >&2
else
  dutchbay_activate_checkout "$PWD" "$_dutchbay_venv"
fi

unset _dutchbay_python _dutchbay_venv
