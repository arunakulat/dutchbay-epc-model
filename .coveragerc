[run]
source = finance,analytics
omit =
    */tests/*
    */__pycache__/*
    */site-packages/*
    */dist-packages/*
    */.venv*/*
    */venv/*
    */setup.py

[report]
precision = 2
show_missing = True
skip_covered = False

exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod

[html]
directory = htmlcov

[xml]
output = coverage.xml
