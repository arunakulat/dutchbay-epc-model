[run]
source = analytics,finance,wind_resource,api,app
omit =
    */tests/*
    */__pycache__/*
    */site-packages/*
    */dist-packages/*
    */.venv*/*
    */venv/*
    */setup.py
    # Untestable infra excluded from the coverage denominator (2026-06-22): these
    # are not unit-testable, so a coverage % over them is meaningless. Hydra/
    # argparse CLI entrypoints, the exploratory PySAM sandbox, the Streamlit/
    # matplotlib dashboards & plotting, and the legacy wind-only pipeline_v14
    # (only scripts/ + legacy_runners/ consume it; the engine was routed off it
    # in #286). Test the engine logic; exclude the shells.
    */analytics/cli/*
    */analytics/pysam_sandbox/*
    */analytics/sensitivity/viz.py
    */analytics/sensitivity/dashboard_demo.py
    */analytics/pipeline_v14.py
    # arq + Redis worker entrypoint (Sprint 2): loaded only by the `arq` CLI with
    # the optional [jobs] extra + a live Redis; never imported by app/tests.
    */app/jobs/worker.py

[report]
precision = 2
show_missing = True
skip_covered = False

exclude_lines =
    pragma: no cover
    def __repr__
    raise AssertionError
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    @abstractmethod
    @abc.abstractmethod
    @overload
    # Ellipsis-only stub bodies (Protocol methods, typing shims) — never executed.
    ^\s*\.\.\.\s*$

[html]
directory = htmlcov

[xml]
output = coverage.xml
